         endforeach()
     else()
+        if(VCS_USE_GLES2_BACKEND)
+            find_package(PkgConfig REQUIRED)
+            pkg_check_modules(VCS_GLES2 REQUIRED IMPORTED_TARGET egl glesv2 sdl2)
+            find_package(Threads REQUIRED)
+            target_compile_definitions(${target} PRIVATE VCS_GLES2_GE_BACKEND=1 VCS_SDL_AUDIO=1)
+            target_link_libraries(${target} PRIVATE PkgConfig::VCS_GLES2 Threads::Threads)
+        endif()
