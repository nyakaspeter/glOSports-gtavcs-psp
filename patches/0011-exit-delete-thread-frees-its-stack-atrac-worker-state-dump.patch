+void atrac_worker_main() {
+    name_host_thread("vcs-atrac");
+    for (;;) {
+        std::uint32_t id = 0u;
+        std::size_t slot = 0u;
+        std::size_t frame_bytes = 0u;
+        std::uint64_t seek = 0u;
+        {
+            std::unique_lock lock(atrac_worker.mutex);
+            atrac_worker.cv.wait(lock, [&id] { return atrac_worker.stop || atrac_worker_pick(id); });
+            if (atrac_worker.stop) break;
+            const AtracPrefetchRing &ring = atrac_worker.rings[id];
+            slot = (ring.head + ring.count) % kAtracRingFrames;
+            frame_bytes = ring.frame_bytes;
+            seek = ring.seek;
+            atrac_worker.busy_context = static_cast<int>(id);
+        }
+        AtracContextState &state = atrac_contexts[id];
+        std::vector<std::uint8_t> &frame = atrac_worker.rings[id].frames[slot];
+        frame.resize(frame_bytes);
+        const bool opened = open_atrac_decoder(state, seek);
+        const std::size_t got = opened ? state.decoder.read(frame) : 0u;
+        {
+            std::lock_guard lock(atrac_worker.mutex);
+            AtracPrefetchRing &ring = atrac_worker.rings[id];
+            atrac_worker.busy_context = -1;
+            if (ring.wanted) {  // not closed meanwhile
+                ring.sizes[slot] = got;
+                ++ring.count;
+                if (!opened || got < frame_bytes) {
+                    ring.eof = true;
+                    state.decoder_eof = true;
+                }
