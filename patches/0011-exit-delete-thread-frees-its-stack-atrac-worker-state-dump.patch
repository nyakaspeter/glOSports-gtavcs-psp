+bool atrac_worker_pick(std::uint32_t &id) {
+    for (std::uint32_t index = 0u; index < atrac_worker.rings.size(); ++index) {
+        const AtracPrefetchRing &ring = atrac_worker.rings[index];
+        if (ring.wanted && !ring.eof && ring.count < kAtracRingFrames) {
+            id = index;
+            return true;
+        }
+    }
+    return false;
