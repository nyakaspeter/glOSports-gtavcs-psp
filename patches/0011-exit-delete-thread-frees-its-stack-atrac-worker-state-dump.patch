+// Guarded by atrac_worker.mutex.
+struct AtracPrefetchRing {
+    bool wanted{};  // keep decoding; cleared by atrac_prefetch_close
+    std::uint64_t seek{};
+    std::size_t frame_bytes{};
+    std::array<std::vector<std::uint8_t>, kAtracRingFrames> frames{};
+    std::array<std::size_t, kAtracRingFrames> sizes{};
+    std::size_t head{};
+    std::size_t count{};
+    bool eof{};
+};
