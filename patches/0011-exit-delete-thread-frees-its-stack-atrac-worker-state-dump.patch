+struct AtracWorker {
+    std::mutex mutex;
+    std::condition_variable cv;        // the worker: work arrived, or stop
+    std::condition_variable ready_cv;  // the game thread: a frame arrived
+    std::thread thread;
+    std::array<AtracPrefetchRing, 6> rings{};
+    int busy_context{-1};
+    bool stop{};
+    bool started{};
+    // Bit per context with a frame (or the end of its stream) to pop; the
+    // game thread polls it without the mutex.
+    std::atomic<std::uint32_t> ready_mask{0u};
+};
+AtracWorker atrac_worker;
