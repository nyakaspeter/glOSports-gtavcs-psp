+        AtracPrefetchRing &ring = atrac_worker.rings[id];
+        if (ring.wanted) return;
+        ring.wanted = true;
+        ring.seek = atrac_open_position(state);
+        ring.frame_bytes =
+            static_cast<std::size_t>(atrac_samples_per_frame(state)) * kAtracOutputChannels * 2u;
+    }
+    atrac_worker.cv.notify_all();
