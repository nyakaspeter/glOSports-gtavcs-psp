+
+// Game thread: the next decoded frame, or false while the worker still owes it.
+bool atrac_prefetch_pop(AtracContextState &state, std::span<std::uint8_t> output,
+                        std::size_t &got) {
+    const std::uint32_t id = atrac_context_index(state);
+    const std::uint32_t bit = 1u << id;
+    std::unique_lock lock(atrac_worker.mutex);
+    AtracPrefetchRing &ring = atrac_worker.rings[id];
+    if (ring.count == 0u) {
+        if (!ring.eof) {
+            atrac_worker.ready_mask.fetch_and(~bit);
+            return false;
+        }
+        got = 0u;
+        return true;
+    }
+    got = std::min(ring.sizes[ring.head], output.size());
+    std::memcpy(output.data(), ring.frames[ring.head].data(), got);
+    ring.head = (ring.head + 1u) % kAtracRingFrames;
+    --ring.count;
+    if (ring.count == 0u && !ring.eof) atrac_worker.ready_mask.fetch_and(~bit);
+    lock.unlock();
+    atrac_worker.cv.notify_all();
+    return true;
+}
+
+// Game thread, when the guest thread could not be parked: block until the
+// worker has something for this context.
+void atrac_prefetch_wait(std::uint32_t id) {
+    std::unique_lock lock(atrac_worker.mutex);
+    atrac_worker.ready_cv.wait(lock, [id] {
+        return !atrac_worker.started || atrac_worker.stop ||
+            (atrac_worker.ready_mask.load() & (1u << id)) != 0u;
+    });
+}
+
+void atrac_worker_stop() {
+    std::thread worker;
+    {
+        std::lock_guard lock(atrac_worker.mutex);
+        if (!atrac_worker.started) return;
+        atrac_worker.stop = true;
+        worker = std::move(atrac_worker.thread);
+    }
+    atrac_worker.cv.notify_all();
+    atrac_worker.ready_cv.notify_all();
+    if (worker.joinable()) worker.join();
+    std::lock_guard lock(atrac_worker.mutex);
+    atrac_worker.started = false;
+    atrac_worker.stop = false;
+    atrac_worker.busy_context = -1;
+    atrac_worker.rings = {};
+    atrac_worker.ready_mask.store(0u);
+}
+
+struct AtracWorkerLifetime {
+    ~AtracWorkerLifetime() { atrac_worker_stop(); }
