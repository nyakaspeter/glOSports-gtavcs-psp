+}
+
+// Game thread: resume the parked threads whose frame the worker delivered (or
+// whose context was reset: the step then answers from the new state).
+void atrac_poll_guest_waits() {
+    if (atrac_wait_mask == 0u) return;
+    const std::uint32_t ready = atrac_worker.ready_mask.load(std::memory_order_acquire);
+    if ((ready & atrac_wait_mask) == 0u) return;
+    for (auto it = atrac_guest_waits.begin(); it != atrac_guest_waits.end();) {
+        const auto thread = thread_table.threads.find(it->first);
+        if (thread == thread_table.threads.end() || thread->second.state != ThreadState::HostWait) {
+            it = atrac_guest_waits.erase(it);
+            continue;
+        }
+        if ((ready & (1u << it->second.request.id)) == 0u ||
+            atrac_decode_step(*it->second.runtime, thread->second.suspended_context,
+                              it->second.request) == AtracDecodeResult::Wait) {
+            ++it;
+            continue;
+        }
+        enqueue_continuation(it->first, thread->second.suspended_context);
+        it = atrac_guest_waits.erase(it);
+    }
+    atrac_refresh_wait_mask();
+}
+
+// Game thread with nothing runnable: block on the worker for a parked thread's
+// frame.  False when no thread is parked or the worker is gone.
+bool atrac_block_for_guest_waits() {
+    if (atrac_guest_waits.empty()) return false;
+    {
+        std::unique_lock lock(atrac_worker.mutex);
+        if (!atrac_worker.started || atrac_worker.stop) return false;
+        atrac_worker.ready_cv.wait(lock, [] {
+            return atrac_worker.stop ||
+                (atrac_worker.ready_mask.load(std::memory_order_acquire) & atrac_wait_mask) != 0u;
+        });
+        if (atrac_worker.stop) return false;
+    }
+    atrac_poll_guest_waits();
+    return true;
+}
+
+// Parks the current thread until the worker has its frame; false when the
+// scheduler could not switch away (the caller then waits on the host thread).
+bool atrac_park_current_thread(psprecomp::Runtime &rt, psprecomp::AllegrexContext &ctx,
+                               const AtracDecodeRequest &request) {
+    const std::int32_t uid = thread_table.current_uid;
+    const auto current = thread_table.threads.find(uid);
+    if (current == thread_table.threads.end()) return false;
+    const psprecomp::AllegrexContext caller = ctx;
+    current->second.state = ThreadState::HostWait;
+    current->second.suspended_context = make_wait_context(ctx);
+    atrac_guest_waits[uid] = AtracGuestWait{&rt, request};
+    atrac_wait_mask |= 1u << request.id;
+    if (activate_next_thread(ctx, "atrac-wait")) return true;
+    atrac_guest_waits.erase(uid);
+    atrac_refresh_wait_mask();
+    current->second.state = ThreadState::Running;
+    ctx = caller;
+    return false;
+}
+
+}
+
+void audio_worker_shutdown() {
+    atrac_worker_stop();
+}
