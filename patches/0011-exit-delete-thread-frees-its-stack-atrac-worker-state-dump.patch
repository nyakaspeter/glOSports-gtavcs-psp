+// One copy of the guest's little-endian samples instead of a load16 each.
+void submit_guest_pcm(psprecomp::Runtime &rt, std::uint32_t address, std::size_t bytes,
+                      std::uint32_t frames, bool stereo, std::uint32_t left, std::uint32_t right,
+                      std::uint32_t source_rate, std::uint32_t channel, std::uint64_t start_us) {
+    static std::vector<std::int16_t> pcm;
+    pcm.resize(bytes / sizeof(std::int16_t));
+    if (const std::uint8_t *raw = rt.memory().raw_pointer(address, bytes)) {
+        std::memcpy(pcm.data(), raw, pcm.size() * sizeof(std::int16_t));
+    } else {
+        for (std::size_t index = 0u; index < pcm.size(); ++index)
+            pcm[index] = static_cast<std::int16_t>(rt.memory().aot_load16(
+                address + static_cast<std::uint32_t>(index * sizeof(std::int16_t))));
+    }
+    vcs::audio_output_submit(pcm, frames, stereo, left, right, source_rate, channel, start_us);
+}
