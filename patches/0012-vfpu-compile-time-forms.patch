+    // ---- Compile-time forms of the remaining generic VFPU operations ----
+    // The generator passes literal registers to vcrsp/vqmul, vhdp, the
+    // vuc2i/vc2i/vus2i/vs2i family, vh2f, vf2h, vocp, vmin/vmax, vscmp/vsge/
+    // vslt, vmmul and the matrix moves; the generic forms recompute the lane
+    // mapping in loops and run every prefix through the lane-by-lane decoder
+    // and the masking writer even when no prefix is set. The forms below take
+    // the registers as template parameters (constant lane mapping) and, while
+    // all three prefixes are the defaults (GTA's code sets one only right
+    // before the instruction it is meant for), skip the prefix work. A pending
+    // prefix takes the generic form, so each result is the generic form's, bit
+    // for bit (tests/vfpu_ct_test.cpp compares the two over random registers).
+    [[nodiscard]] PSPRECOMP_CONTEXT_FORCEINLINE bool vfpu_prefixes_default() const noexcept {
+        return vfpu_ctrl[0] == 0xE4u && vfpu_ctrl[1] == 0xE4u && vfpu_ctrl[2] == 0u;
+    }
+
+    // The prefix negate: the sign bit flipped, also on a NaN.
+    [[nodiscard]] static PSPRECOMP_CONTEXT_FORCEINLINE float vfpu_negate(float value) noexcept {
+        return std::bit_cast<float>(std::bit_cast<std::uint32_t>(value) ^ 0x80000000u);
+    }
