+    // vcrsp.t (Length 3) and vqmul.q (Length 4).
+    template <std::uint32_t DestinationRegister, std::uint32_t SourceRegister,
+              std::uint32_t TargetRegister, std::uint32_t Length>
+    PSPRECOMP_CONTEXT_FORCEINLINE void execute_vfpu_cross_quat_ct() noexcept {
+        static_assert(Length >= 1u && Length <= 4u);
+        if constexpr (Length == 3u || Length == 4u) {
+            if (vfpu_prefixes_default()) [[likely]] {
+                float source[4]{};
+                float target[4]{};
+                float result[4]{};
+                read_vfpu_vector_ct<SourceRegister, Length>(source);
+                read_vfpu_vector_ct<TargetRegister, Length>(target);
+                if constexpr (Length == 3u) {
+                    result[0] = source[1] * target[2] - source[2] * target[1];
+                    result[1] = source[2] * target[0] - source[0] * target[2];
+                    // The generic form's forced T view [T.y, -T.x, T.w, T.z]
+                    // (T.w: the zero lane beyond a 3-lane read).
+                    const float view[4]{target[1], vfpu_negate(target[0]), target[3], target[2]};
+                    result[2] = source[0] * view[0] + source[1] * view[1] +
+                                source[2] * view[2] + source[3] * view[3];
+                } else {
+                    result[0] = source[0] * target[3] + source[1] * target[2] -
+                                source[2] * target[1] + source[3] * target[0];
+                    result[1] = -source[0] * target[2] + source[1] * target[3] +
+                                 source[2] * target[0] + source[3] * target[1];
+                    result[2] = source[0] * target[1] - source[1] * target[0] +
+                                source[2] * target[3] + source[3] * target[2];
+                    // Forced T view [-T.x, -T.y, -T.z, T.w].
+                    const float view[4]{vfpu_negate(target[0]), vfpu_negate(target[1]),
+                                        vfpu_negate(target[2]), target[3]};
+                    result[3] = source[0] * view[0] + source[1] * view[1] +
+                                source[2] * view[2] + source[3] * view[3];
+                }
+                write_vfpu_vector_ct<DestinationRegister, Length>(result);
+                return;  // the prefixes stay the defaults, as after the generic form's eat
+            }
+        }
+        execute_vfpu_cross_quat_slow(DestinationRegister, SourceRegister, TargetRegister, Length);
+    }
+
+    template <std::uint32_t DestinationScalarRegister, std::uint32_t SourceRegister,
+              std::uint32_t TargetRegister, std::uint32_t Length>
+    PSPRECOMP_CONTEXT_FORCEINLINE void execute_vfpu_vhdp_ct() noexcept {
+        static_assert(Length >= 1u && Length <= 4u);
+        if (vfpu_prefixes_default()) [[likely]] {
+            float source[4]{};
+            float target[4]{};
+            read_vfpu_vector_ct<SourceRegister, Length>(source);
+            read_vfpu_vector_ct<TargetRegister, Length>(target);
+            source[Length - 1u] = 1.0f;  // the forced constant ONE (no abs or negate pending)
+            float sum = 0.0f;
+            for (std::uint32_t lane = 0u; lane < 4u; ++lane) sum += source[lane] * target[lane];
+            if (std::isnan(sum)) sum = std::fabs(sum);
+            const float result[1]{sum};
+            write_vfpu_vector_ct<DestinationScalarRegister, 1u>(result);
+            return;
+        }
+        execute_vfpu_vhdp_slow(DestinationScalarRegister, SourceRegister, TargetRegister, Length);
+    }
+
+    // vuc2i / vc2i / vus2i / vs2i (Operation 0..3).
+    template <std::uint32_t DestinationRegister, std::uint32_t SourceRegister,
+              std::uint32_t SourceLength, std::uint32_t Operation>
+    PSPRECOMP_CONTEXT_FORCEINLINE void execute_vfpu_vx2i_ct() noexcept {
+        static_assert(SourceLength >= 1u && SourceLength <= 4u && Operation <= 3u);
+        if (vfpu_prefixes_default()) [[likely]] {
+            float source[4]{};
+            read_vfpu_vector_ct<SourceRegister, SourceLength>(source);
+            std::uint32_t result_bits[4]{};
+            constexpr std::uint32_t destination_length =
+                Operation <= 1u ? 4u : (SourceLength == 1u ? 2u : 4u);
+            if constexpr (Operation == 0u) {
+                std::uint32_t value = std::bit_cast<std::uint32_t>(source[0]);
+                for (std::uint32_t lane = 0u; lane < 4u; ++lane) {
+                    result_bits[lane] = ((value & 0xFFu) * 0x01010101u) >> 1u;
+                    value >>= 8u;
+                }
+            } else if constexpr (Operation == 1u) {
+                const std::uint32_t value = std::bit_cast<std::uint32_t>(source[0]);
+                result_bits[0] = (value & 0x000000FFu) << 24u;
+                result_bits[1] = (value & 0x0000FF00u) << 16u;
+                result_bits[2] = (value & 0x00FF0000u) << 8u;
+                result_bits[3] = value & 0xFF000000u;
+            } else {
+                constexpr std::uint32_t input_count = SourceLength < 2u ? SourceLength : 2u;
+                for (std::uint32_t lane = 0u; lane < input_count; ++lane) {
+                    const std::uint32_t value = std::bit_cast<std::uint32_t>(source[lane]);
+                    if constexpr (Operation == 2u) {
+                        result_bits[lane * 2u] = (value & 0x0000FFFFu) << 15u;
+                        result_bits[lane * 2u + 1u] = (value & 0xFFFF0000u) >> 1u;
+                    } else {
+                        result_bits[lane * 2u] = (value & 0x0000FFFFu) << 16u;
+                        result_bits[lane * 2u + 1u] = value & 0xFFFF0000u;
+                    }
+                }
+            }
+            float result[4]{};
+            for (std::uint32_t lane = 0u; lane < destination_length; ++lane)
+                result[lane] = std::bit_cast<float>(result_bits[lane]);
+            write_vfpu_vector_ct<DestinationRegister, destination_length>(result);
+            return;
+        }
+        execute_vfpu_vx2i_slow(DestinationRegister, SourceRegister, SourceLength, Operation);
+    }
+
+    template <std::uint32_t DestinationRegister, std::uint32_t SourceRegister, std::uint32_t SourceLength>
+    PSPRECOMP_CONTEXT_FORCEINLINE void execute_vfpu_vh2f_ct() noexcept {
+        static_assert(SourceLength >= 1u && SourceLength <= 4u);
+        if (vfpu_prefixes_default()) [[likely]] {
+            float source[4]{};
+            read_vfpu_vector_ct<SourceRegister, SourceLength>(source);
+            const std::uint32_t first_word = std::bit_cast<std::uint32_t>(source[0]);
+            float result[4]{
+                std::bit_cast<float>(vfpu_expand_half_bits(static_cast<std::uint16_t>(first_word))),
+                std::bit_cast<float>(vfpu_expand_half_bits(static_cast<std::uint16_t>(first_word >> 16u))),
+                0.0f,
+                0.0f,
+            };
+            constexpr std::uint32_t destination_length = SourceLength == 1u ? 2u : 4u;
+            if constexpr (destination_length == 4u) {
+                const std::uint32_t second_word = std::bit_cast<std::uint32_t>(source[1]);
+                result[2] = std::bit_cast<float>(vfpu_expand_half_bits(static_cast<std::uint16_t>(second_word)));
+                result[3] = std::bit_cast<float>(vfpu_expand_half_bits(static_cast<std::uint16_t>(second_word >> 16u)));
+            }
+            write_vfpu_vector_ct<DestinationRegister, destination_length>(result);
+            return;
+        }
+        execute_vfpu_vh2f_slow(DestinationRegister, SourceRegister, SourceLength);
+    }
+
+    template <std::uint32_t DestinationRegister, std::uint32_t SourceRegister, std::uint32_t SourceLength>
+    PSPRECOMP_CONTEXT_FORCEINLINE void execute_vfpu_vf2h_ct() noexcept {
+        static_assert(SourceLength >= 1u && SourceLength <= 4u);
+        if (vfpu_prefixes_default()) [[likely]] {
+            float source[4]{};
+            read_vfpu_vector_ct<SourceRegister, SourceLength>(source);
+            std::uint32_t packed[2]{};
+            packed[0] = static_cast<std::uint32_t>(vfpu_shrink_to_half_bits(source[0])) |
+                        (static_cast<std::uint32_t>(vfpu_shrink_to_half_bits(source[1])) << 16u);
+            constexpr std::uint32_t destination_length = SourceLength <= 2u ? 1u : 2u;
+            if constexpr (destination_length == 2u) {
+                packed[1] = static_cast<std::uint32_t>(vfpu_shrink_to_half_bits(source[2])) |
+                            (static_cast<std::uint32_t>(vfpu_shrink_to_half_bits(source[3])) << 16u);
+            }
+            const float result[2]{std::bit_cast<float>(packed[0]), std::bit_cast<float>(packed[1])};
+            write_vfpu_vector_ct<DestinationRegister, destination_length>(result);
+            return;
+        }
+        execute_vfpu_vf2h_slow(DestinationRegister, SourceRegister, SourceLength);
+    }
+
+    template <std::uint32_t DestinationRegister, std::uint32_t SourceRegister, std::uint32_t Length>
+    PSPRECOMP_CONTEXT_FORCEINLINE void execute_vfpu_vocp_ct() noexcept {
+        static_assert(Length >= 1u && Length <= 4u);
+        if (vfpu_prefixes_default()) [[likely]] {
+            float source[4]{};
+            read_vfpu_vector_ct<SourceRegister, Length>(source);
+            float result[4]{};
+            for (std::uint32_t lane = 0u; lane < Length; ++lane) {
+                const float negated = vfpu_negate(source[lane]);  // the forced S negate
+                result[lane] = std::isnan(negated) ? std::fabs(negated) : 1.0f + negated;
+            }
+            write_vfpu_vector_ct<DestinationRegister, Length>(result);
+            return;
+        }
+        execute_vfpu_vocp_slow(DestinationRegister, SourceRegister, Length);
+    }
+
+    template <std::uint32_t DestinationRegister, std::uint32_t SourceRegister,
+              std::uint32_t TargetRegister, std::uint32_t Length, bool Maximum>
+    PSPRECOMP_CONTEXT_FORCEINLINE void execute_vfpu_vminmax_ct() noexcept {
+        static_assert(Length >= 1u && Length <= 4u);
+        if (vfpu_prefixes_default()) [[likely]] {
+            float source[4]{};
+            float target[4]{};
+            float result[4]{};
+            read_vfpu_vector_ct<SourceRegister, Length>(source);
+            read_vfpu_vector_ct<TargetRegister, Length>(target);
+            for (std::uint32_t lane = 0u; lane < Length; ++lane) {
+                result[lane] = std::bit_cast<float>(vfpu_minmax_bits(
+                    std::bit_cast<std::uint32_t>(source[lane]),
+                    std::bit_cast<std::uint32_t>(target[lane]), Maximum));
+            }
+            write_vfpu_vector_ct<DestinationRegister, Length>(result);
+            return;
+        }
+        execute_vfpu_vminmax_slow(DestinationRegister, SourceRegister, TargetRegister, Length, Maximum);
+    }
+
+    // vscmp / vsge / vslt (Operation 5 / 6 / 7).
+    template <std::uint32_t DestinationRegister, std::uint32_t SourceRegister,
+              std::uint32_t TargetRegister, std::uint32_t Length, std::uint32_t Operation>
+    PSPRECOMP_CONTEXT_FORCEINLINE void execute_vfpu_compare3_ct() noexcept {
+        static_assert(Length >= 1u && Length <= 4u && Operation >= 5u && Operation <= 7u);
+        if (vfpu_prefixes_default()) [[likely]] {
+            float source[4]{};
+            float target[4]{};
+            float result[4]{};
+            read_vfpu_vector_ct<SourceRegister, Length>(source);
+            read_vfpu_vector_ct<TargetRegister, Length>(target);
+            for (std::uint32_t lane = 0u; lane < Length; ++lane) {
+                if constexpr (Operation == 5u) {
+                    const float difference = source[lane] - target[lane];
+                    if (std::isnan(difference)) {
+                        const std::uint32_t source_bits = std::bit_cast<std::uint32_t>(source[lane]);
+                        const std::uint32_t target_bits = std::bit_cast<std::uint32_t>(target[lane]);
+                        const std::int64_t source_magnitude = static_cast<std::int64_t>(source_bits & 0x7FFFFFFFu);
+                        const std::int64_t target_magnitude = static_cast<std::int64_t>(target_bits & 0x7FFFFFFFu);
+                        const std::int64_t ordered_source = (source_bits & 0x80000000u) != 0u
+                            ? -source_magnitude : source_magnitude;
+                        const std::int64_t ordered_target = (target_bits & 0x80000000u) != 0u
+                            ? -target_magnitude : target_magnitude;
+                        result[lane] = ordered_source > ordered_target ? 1.0f
+                                     : ordered_source < ordered_target ? -1.0f : 0.0f;
+                    } else {
+                        result[lane] = difference > 0.0f ? 1.0f : difference < 0.0f ? -1.0f : 0.0f;
+                    }
+                } else if constexpr (Operation == 6u) {
+                    result[lane] = (!std::isnan(source[lane]) && !std::isnan(target[lane]) &&
+                                    source[lane] >= target[lane]) ? 1.0f : 0.0f;
+                } else {
+                    result[lane] = (!std::isnan(source[lane]) && !std::isnan(target[lane]) &&
+                                    source[lane] < target[lane]) ? 1.0f : 0.0f;
+                }
+            }
+            write_vfpu_vector_ct<DestinationRegister, Length>(result);
+            return;
+        }
+        execute_vfpu_compare3_slow(DestinationRegister, SourceRegister, TargetRegister, Length, Operation);
+    }
+
+    // read_vfpu_matrix / write_vfpu_matrix with the slots of the
+    // destination[j * 4 + i] they fill as constants.
+    template <std::uint32_t MatrixRegister, std::uint32_t Side>
+    static constexpr std::array<std::uint8_t, 16> vfpu_matrix_slots = [] {
+        std::array<std::uint8_t, 16> slots{};
+        for (std::uint32_t j = 0u; j < Side; ++j)
+            for (std::uint32_t i = 0u; i < Side; ++i)
+                slots[j * 4u + i] = static_cast<std::uint8_t>(vfpu_matrix_slot<MatrixRegister, Side>(j, i));
+        return slots;
+    }();
+
+    template <std::uint32_t MatrixRegister, std::uint32_t Side>
+    PSPRECOMP_CONTEXT_FORCEINLINE void read_vfpu_matrix_ct(float *destination) const noexcept {
+        static_assert(Side >= 1u && Side <= 4u);
+        constexpr std::array<std::uint8_t, 16> slots = vfpu_matrix_slots<MatrixRegister, Side>;
+        for (std::uint32_t j = 0u; j < Side; ++j)
+            for (std::uint32_t i = 0u; i < Side; ++i) destination[j * 4u + i] = vfpu[slots[j * 4u + i]];
+    }
+
+    template <std::uint32_t MatrixRegister, std::uint32_t Side>
+    PSPRECOMP_CONTEXT_FORCEINLINE void write_vfpu_matrix_ct(const float *source) noexcept {
+        static_assert(Side >= 1u && Side <= 4u);
+        constexpr std::array<std::uint8_t, 16> slots = vfpu_matrix_slots<MatrixRegister, Side>;
+        for (std::uint32_t j = 0u; j < Side; ++j)
+            for (std::uint32_t i = 0u; i < Side; ++i) vfpu[slots[j * 4u + i]] = source[j * 4u + i];
+    }
+
+#if defined(__ARM_NEON)
+    // Lanes 0..Side-1 hold vfpu_matrix[RowIndex * 4 + c], c = 0..Side-1: the
+    // target row vmmul multiplies the source columns by.
+    template <std::uint32_t MatrixRegister, std::uint32_t Side, std::uint32_t RowIndex>
+    [[nodiscard]] PSPRECOMP_CONTEXT_FORCEINLINE float32x4_t vfpu_matrix_row_q() const noexcept {
+        static_assert(Side == 3u || Side == 4u);
+        constexpr std::size_t s0 = vfpu_matrix_slot<MatrixRegister, Side>(RowIndex, 0u);
+        constexpr std::size_t s1 = vfpu_matrix_slot<MatrixRegister, Side>(RowIndex, 1u);
+        constexpr std::size_t s2 = vfpu_matrix_slot<MatrixRegister, Side>(RowIndex, 2u);
+        constexpr std::size_t s3 = Side == 4u ? vfpu_matrix_slot<MatrixRegister, Side>(RowIndex, 3u) : s0 + 3u;
+        constexpr bool contiguous = s1 == s0 + 1u && s2 == s0 + 2u && s3 == s0 + 3u;
+        const float *const p = vfpu.data();
+        if constexpr (contiguous && (s0 & 3u) == 0u) {
+            return vld1q_f32(p + s0);
+        } else {
+            float32x4_t v = vld1q_dup_f32(p + s0);
+            v = vld1q_lane_f32(p + s1, v, 1);
+            v = vld1q_lane_f32(p + s2, v, 2);
+            if constexpr (Side == 4u) v = vld1q_lane_f32(p + s3, v, 3);
+            return v;
+        }
+    }
+
+    // Lane c of `value` to vfpu_matrix[RowIndex * 4 + c] (write_vfpu_matrix's slot).
+    template <std::uint32_t MatrixRegister, std::uint32_t Side, std::uint32_t RowIndex>
+    PSPRECOMP_CONTEXT_FORCEINLINE void vfpu_matrix_row_store_q(float32x4_t value) noexcept {
+        static_assert(Side == 3u || Side == 4u);
+        constexpr std::size_t s0 = vfpu_matrix_slot<MatrixRegister, Side>(RowIndex, 0u);
+        constexpr std::size_t s1 = vfpu_matrix_slot<MatrixRegister, Side>(RowIndex, 1u);
+        constexpr std::size_t s2 = vfpu_matrix_slot<MatrixRegister, Side>(RowIndex, 2u);
+        constexpr std::size_t s3 = Side == 4u ? vfpu_matrix_slot<MatrixRegister, Side>(RowIndex, 3u) : s0 + 3u;
+        float *const p = vfpu.data();
+        if constexpr (Side == 4u && s1 == s0 + 1u && s2 == s0 + 2u && s3 == s0 + 3u) {
+            vst1q_f32(p + s0, value);
+        } else {
+            vst1q_lane_f32(p + s0, value, 0);
+            vst1q_lane_f32(p + s1, value, 1);
+            vst1q_lane_f32(p + s2, value, 2);
+            if constexpr (Side == 4u) vst1q_lane_f32(p + s3, value, 3);
+        }
+    }
+
+    // Row a of vmmul's result (lanes over b): sum over c of
+    // source column c (lanes over b) * target[a][c].
+    template <std::uint32_t TargetRegister, std::uint32_t Side, std::uint32_t RowIndex>
+    [[nodiscard]] PSPRECOMP_CONTEXT_FORCEINLINE float32x4_t vfpu_vmmul_row_q(
+        float32x4_t c0, float32x4_t c1, float32x4_t c2, float32x4_t c3) const noexcept {
+        const float32x4_t t = vfpu_matrix_row_q<TargetRegister, Side, RowIndex>();
+        float32x4_t sum = vmulq_lane_f32(c0, vget_low_f32(t), 0);
+        sum = vaddq_f32(sum, vmulq_lane_f32(c1, vget_low_f32(t), 1));
+        sum = vaddq_f32(sum, vmulq_lane_f32(c2, vget_high_f32(t), 0));
