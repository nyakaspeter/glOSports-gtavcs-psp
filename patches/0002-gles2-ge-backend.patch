+}  // namespace
+
+// ------------------------------------------------------------- public API --
+// Everything below runs on the GE thread (or the window thread, for guest
+// frames) and never touches GL.
+
+namespace {
+
+bool is_target(Gles2State &s, std::uint32_t address) {
+    return s.targets.find(address & 0x001FFFF0u) != s.targets.end();
+}
+
+// A texture read from a render target. Only the direct-colour formats can be
+// one: a palette texture loaded where a target used to be (the weapon icon at
+// 0x178000, the loading screen's buffer, after loading a save) showed a
+// miniature of the screen.
+// The GE side's record of a texture: uploaded, or in this frame's uploads
+// (the merge loop then picks the textured program without the render
+// thread's map).
+const TextureInfo *find_texture(const Gles2State &s, std::uint64_t key) {
+    const auto found = s.textures.find(key);
+    return found != s.textures.end() ? &found->second : nullptr;
+}
+
+bool is_target_texture(Gles2State &s, const GeGpuDrawDescriptor &draw) {
+    return draw.texture_format <= 3u && is_target(s, draw.texture_address);
+}
+
+void note_target(Gles2State &s, std::uint32_t address, std::uint32_t width, std::uint32_t height,
+                 std::uint32_t stride) {
+    TargetSize &target = s.targets[address & 0x001FFFF0u];
+    target.address = address & 0x001FFFF0u;
+    // The size is the largest clip rectangle drawn into the target this frame
+    // (applied in ge_gpu_backend_finish_color_frame), at least 480 x 272 (or
+    // the stride, for smaller targets): VCS composes gameplay into 512 x 320
+    // (the stride and the rows below 272) and shows all of it, but lays out
+    // menus and loading screens in 480 x 272, and squeezes the loading art
+    // from its 512 x 320 working buffer into a 480 x 272 one. A size kept
+    // from earlier frames showed those with black bands or, for the two
+    // buffers the pause menu alternates between, at two scales (flicker).
+    // One frame's largest clip, not each draw's: the help box clips to a few
+    // rows and zoomed the frame in.
+    Gles2State::FrameExtent &extent = s.frame_extents[target.address];
+    extent.width = std::max(extent.width, std::min(width, stride));
+    extent.height = std::max(extent.height, height);
+    extent.stride = std::max(extent.stride, stride);
+}
+
+bool prepare_texture(Gles2State &s, const GeGpuDrawDescriptor &draw, std::uint32_t width,
+                     std::uint32_t height, std::uint32_t mips, std::vector<std::byte> rgba) {
+    if (width == 0u) width = draw.texture_width;
+    if (height == 0u) height = draw.texture_height;
+    if (width == 0u || height == 0u || rgba.empty() || mips == 0u) return false;
+    const std::uint64_t key = texture_key(draw);
+    TextureInfo &texture = s.textures[key];
+    s.texture_bytes -= std::min(s.texture_bytes, texture.bytes);
+    texture.descriptor = draw;
+    texture.bytes = rgba.size();
+    texture.signature_epoch = s.frame_epoch;
+    texture.last_used_epoch = s.frame_epoch;
+    s.texture_bytes += texture.bytes;
+    s.last_texture_rgba.assign(rgba.begin(),
+                               rgba.begin() + std::min(rgba.size(), static_cast<std::size_t>(width) * height * 4u));
+    SharedTextures &shared = s.render.shared;
+    if (s.use_upload_thread && !shared.failed.load(std::memory_order_relaxed)) {
+        // To the upload thread now; the frame carries the job, which the
+        // render thread adopts (or takes over) before the frame's draws.
+        auto job = std::make_shared<UploadJob>();
+        job->upload = {key, width, height, mips, std::move(rgba), {}};
+        s.uploads.push_back({key, width, height, mips, {}, job});
+        {
+            std::lock_guard<std::mutex> lock(shared.mutex);
+            shared.queue.push_back(std::move(job));
+        }
+        shared.cv.notify_one();
+    } else {
+        s.uploads.push_back({key, width, height, mips, std::move(rgba)});
+    }
+    ++s.report.decoded_texture_uploads;
+    s.report.unique_texture_keys = s.textures.size();
+    return true;
+}
+
+// Least-recently-used textures not drawn this frame go when the budget is
+// exceeded; the render thread deletes them with the frame.
+void evict_textures(Gles2State &s) {
+    if (s.texture_bytes <= kTextureBudgetBytes) return;
+    std::vector<std::pair<std::uint64_t, std::uint64_t>> stale;
+    for (const auto &entry : s.textures)
+        if (entry.second.last_used_epoch < s.frame_epoch) stale.emplace_back(entry.second.last_used_epoch, entry.first);
+    std::sort(stale.begin(), stale.end());
+    for (const auto &item : stale) {
+        if (s.texture_bytes <= kTextureBudgetBytes) break;
+        const auto found = s.textures.find(item.second);
+        if (found == s.textures.end()) continue;
+        s.texture_bytes -= std::min(s.texture_bytes, found->second.bytes);
+        s.textures.erase(found);
+        s.deletes.push_back(item.second);
+        ++s.report.evicted_textures;
+    }
+}
+
+}  // namespace
+
+bool initialize_ge_gpu_backend(std::string &error) {
+    Gles2State &s = state();
+    std::lock_guard<std::recursive_mutex> guard(s.mutex);
+    destroy_backend(s);
+    s.report = {};
+    s.display_framebuffer = 0u;
+    const RenderingConfiguration &rendering = vcs_configuration().rendering;
+    const bool requested_gpu = rendering.backend == RenderingBackend::DirectX12;
+    s.report.requested = requested_gpu ? GeGpuBackendKind::Vulkan : GeGpuBackendKind::Software;
+    s.report.active = GeGpuBackendKind::Software;
+    if (!requested_gpu || !rendering.dx12_ge_color) {
+        s.report.message = "Software GE backend active";
+        error.clear();
+        return true;
+    }
+    if (!create_backend(s, error)) {
+        s.report.message = "GLES2 GE unavailable; using the software GE: " + error;
+        std::cerr << "[gles2] " << error << "; software GE\n";
+        destroy_backend(s);
+        error.clear();
+        return true;
+    }
+    s.enabled = true;
+    s.report.active = GeGpuBackendKind::Vulkan;  // "a GPU backend"; the enum has no GLES2
+    s.report.message = "GLES2 GE backend active (ARM Mali fbdev)";
+    s.report.offscreen_width = s.render.target_width;
+    s.report.offscreen_height = s.render.target_height;
+    s.report.swapchain_active = true;
+    error.clear();
+    return true;
+}
+
+void shutdown_ge_gpu_backend() noexcept {
+    Gles2State &s = state();
+    std::lock_guard<std::recursive_mutex> guard(s.mutex);
+    destroy_backend(s);
+    s.report = {};
+    s.vertices.clear();
+    s.indices.clear();
+    s.batches.clear();
+}
+
+bool ge_gpu_backend_active() noexcept { return state().enabled; }
+bool ge_gpu_backend_transfer_ready() noexcept { return state().enabled; }
+bool ge_gpu_backend_graphics_ready() noexcept { return state().enabled; }
+
+void ge_gpu_backend_record_draw(const GeGpuDrawDescriptor &draw) noexcept {
+    Gles2State &s = state();
+    std::lock_guard<std::recursive_mutex> guard(s.mutex);
+    if (!s.enabled) return;
+    ++s.report.draw_calls;
+    s.report.vertices += draw.vertex_count;
+    const std::uint32_t target = draw.framebuffer_address & 0x001FFFF0u;
+    if (draw.framebuffer_stride != 0u || target == s.display_framebuffer) {
+        // The displayed buffer too: VCS draws its loading art into 512 x 320
+        // there, which a fixed 480 x 272 mapping magnified and cropped.
+        const std::uint32_t stride = std::max<std::uint32_t>(1u, draw.framebuffer_stride != 0u
+            ? draw.framebuffer_stride
+            : target == s.display_framebuffer ? s.display_logical_width
+                                              : static_cast<std::uint32_t>(std::max(1, draw.scissor_x1 + 1)));
+        note_target(s, target, static_cast<std::uint32_t>(std::max(1, draw.scissor_x1 + 1)),
+                    static_cast<std::uint32_t>(std::max(1, draw.scissor_y1 + 1)), stride);
+    }
+}
+
+void ge_gpu_backend_observe_camera(const std::array<float, 12> &, const std::array<float, 16> &,
+                                   const std::array<float, 6> &, const std::array<float, 3> &,
+                                   const GeGpuDrawDescriptor &, std::uint32_t) noexcept {}
+
+bool ge_gpu_backend_stage_vertices(const GeGpuDrawDescriptor &, std::span<const GeGpuVertex> vertices) noexcept {
+    Gles2State &s = state();
+    std::lock_guard<std::recursive_mutex> guard(s.mutex);
+    if (!s.enabled) return false;
+    ++s.report.staged_draw_calls;
+    s.report.staged_vertices += vertices.size();
+    return true;
+}
+
+bool ge_gpu_backend_texture_needed(const GeGpuDrawDescriptor &draw) noexcept {
+    Gles2State &s = state();
+    std::lock_guard<std::recursive_mutex> guard(s.mutex);
+    if (!s.enabled || !draw.texture_enabled || draw.texture_format > 10u ||
+        draw.texture_width == 0u || draw.texture_height == 0u) return false;
+    if (is_target_texture(s, draw)) {
+        ++s.report.texture_cache_hits;
+        return false;
+    }
+    ++s.report.texture_decode_requests;
+    const auto found = s.textures.find(texture_key(draw));
+    if (found == s.textures.end()) return true;
+    found->second.signature_epoch = s.frame_epoch;
+    found->second.last_used_epoch = s.frame_epoch;
+    if (draw.texture_content_signature != 0u &&
+        found->second.descriptor.texture_content_signature != draw.texture_content_signature)
+        return true;
+    ++s.report.texture_cache_hits;
+    return false;
+}
+
+void ge_gpu_backend_prepare_texture_keys(GeGpuDrawDescriptor &draw) noexcept {
+    if (!draw.texture_enabled) {
+        draw.texture_cache_key_hint = 0u;
+        draw.texture_image_key_hint = 0u;
+        return;
+    }
+    // Once per textured PRIM, about a thousand a frame in a cutscene, and
+    // consecutive ones mostly share the texture: the 64-bit hash over all the
+    // identity fields (~10% of the game thread there) only runs when a field
+    // differs from the previous PRIM's.
+    struct Identity {
+        std::array<std::uint32_t, 8> level_addresses, level_buffer_widths, level_widths, level_heights;
+        std::uint32_t address, buffer_width, width, height, format, clut_address, clut_format, clut_shift,
+            clut_mask, clut_start, clut_checksum, max_level, level_mode, level_offset16, selected_level, flags;
+    };
+    Identity id{};
+    id.level_addresses = draw.texture_level_addresses;
+    id.level_buffer_widths = draw.texture_level_buffer_widths;
+    id.level_widths = draw.texture_level_widths;
+    id.level_heights = draw.texture_level_heights;
+    id.address = draw.texture_address;
+    id.buffer_width = draw.texture_buffer_width;
+    id.width = draw.texture_width;
+    id.height = draw.texture_height;
+    id.format = draw.texture_format;
+    id.clut_address = draw.clut_address;
+    id.clut_format = draw.clut_format;
+    id.clut_shift = draw.clut_shift;
+    id.clut_mask = draw.clut_mask;
+    id.clut_start = draw.clut_start;
+    id.clut_checksum = draw.clut_checksum;
+    id.max_level = draw.texture_max_level;
+    id.level_mode = draw.texture_level_mode;
+    id.level_offset16 = static_cast<std::uint32_t>(draw.texture_level_offset16);
+    id.selected_level = draw.texture_selected_level;
+    id.flags = (draw.texture_swizzled ? 1u : 0u) | (draw.texture_min_linear ? 2u : 0u) |
+               (draw.texture_mag_linear ? 4u : 0u) | (draw.texture_mipmap_enabled ? 8u : 0u) |
+               (draw.texture_mipmap_linear ? 16u : 0u) | (draw.texture_clamp_u ? 32u : 0u) |
+               (draw.texture_clamp_v ? 64u : 0u);
+    static thread_local Identity last_id{};
+    static thread_local std::uint64_t last_key = 0u;
+    if (last_key == 0u || std::memcmp(&id, &last_id, sizeof(Identity)) != 0) {
+        draw.texture_cache_key_hint = 0u;
+        last_key = texture_key(draw);
+        last_id = id;
+    }
+    draw.texture_cache_key_hint = last_key;
+    draw.texture_image_key_hint = last_key;
+}
+
+bool ge_gpu_backend_texture_signature_needed(const GeGpuDrawDescriptor &draw) noexcept {
+    Gles2State &s = state();
+    std::lock_guard<std::recursive_mutex> guard(s.mutex);
+    if (!s.enabled || !draw.texture_enabled || draw.texture_width == 0u || draw.texture_height == 0u)
+        return false;
+    if (is_target_texture(s, draw)) return false;
+    const auto found = s.textures.find(texture_key(draw));
+    return found == s.textures.end() || found->second.signature_epoch != s.frame_epoch;
+}
+
+bool ge_gpu_backend_is_framebuffer_feedback_texture(const GeGpuDrawDescriptor &draw) noexcept {
+    Gles2State &s = state();
+    std::lock_guard<std::recursive_mutex> guard(s.mutex);
+    return s.enabled && draw.texture_enabled && is_target_texture(s, draw);
+}
+
+// [Widescreen] AspectRatio=4:3: the game builds its projection for 4:3 and
+// the frame fills the 4:3 screen. The interface is authored for 16:9, so the
+// renderer squeezes it vertically by this factor (0.75; see the shrink < 1
+// branch in render_ge_primitive).
+GeGpuWidescreenHud ge_gpu_backend_widescreen_hud(const GeGpuDrawDescriptor &draw) noexcept {
+    GeGpuWidescreenHud hud{};
+    Gles2State &s = state();
+    if (!s.enabled) return hud;
+    static const float shrink = [] {
+        const VcsConfiguration &config = vcs_configuration();
+        const float aspect = resolve_widescreen_aspect_ratio(config, 640u, 480u);
+        return aspect > 0.0f ? std::clamp(aspect / kGameNativeAspectRatio, 0.5f, 1.0f) : 1.0f;
+    }();
+    if (shrink == 1.0f) return hud;
+    std::uint32_t logical_width = 480u;
+    {
+        std::lock_guard<std::recursive_mutex> guard(s.mutex);
+        const auto found = s.targets.find(draw.framebuffer_address & 0x001FFFF0u);
+        if (found != s.targets.end() && found->second.logical_width != 0u)
+            logical_width = found->second.logical_width;
+    }
+    hud.shrink = shrink;
+    hud.display_scale_x = 480.0f / static_cast<float>(logical_width);
+    hud.source_center = static_cast<float>(logical_width) * 0.5f;
+    return hud;
+}
+
+void ge_gpu_backend_note_through_extent(const GeGpuDrawDescriptor &, float, float) noexcept {}
+bool ge_gpu_backend_adopt_shared_texture(const GeGpuDrawDescriptor &) noexcept { return false; }
+
+bool ge_gpu_backend_texture_available(const GeGpuDrawDescriptor &draw) noexcept {
+    Gles2State &s = state();
+    std::lock_guard<std::recursive_mutex> guard(s.mutex);
+    if (!s.enabled || !draw.texture_enabled) return false;
+    if (is_target_texture(s, draw)) return true;
+    const auto found = s.textures.find(texture_key(draw));
+    if (found == s.textures.end()) return false;
+    // Uploaded, or uploaded before this frame's draws on the render thread.
+    found->second.last_used_epoch = s.frame_epoch;
+    return true;
+}
