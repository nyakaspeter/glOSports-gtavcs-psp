+bool ge_gpu_backend_copy_last_texture_rgba(std::span<std::byte> destination) noexcept {
+    Gles2State &s = state();
+    std::lock_guard<std::recursive_mutex> guard(s.mutex);
+    if (s.last_texture_rgba.empty() || destination.size() < s.last_texture_rgba.size()) return false;
+    std::memcpy(destination.data(), s.last_texture_rgba.data(), s.last_texture_rgba.size());
+    return true;
+}
+
+void ge_gpu_backend_accumulate_color_triangles(const GeGpuDrawDescriptor &draw,
+                                               std::span<const GeGpuVertex> triangle_vertices) noexcept {
+    Gles2State &s = state();
+    std::lock_guard<std::recursive_mutex> guard(s.mutex);
+    if (!s.enabled || triangle_vertices.empty() || triangle_vertices.size() % 3u != 0u) return;
+    if (s.vertices.size() + triangle_vertices.size() > kMaxFrameVertices) {
+        ++s.report.game_vertex_overflows;
+        return;
+    }
+    const bool sampled = draw.texture_enabled && ge_gpu_backend_texture_available(draw) &&
+                         draw.texture_width != 0u && draw.texture_height != 0u;
+    // A target read as a texture holds its logical frame, not the texture
+    // size the GE declares: VCS copies its 512 x 320 working buffer into the
+    // 272-row loading screen as a 512 x 512 texture, and dividing by 512
+    // left the bottom 120 rows (the logo) out.
+    std::uint32_t texture_width = draw.texture_width, texture_height = draw.texture_height;
+    if (sampled) {
+        if (const auto source = s.targets.find(draw.texture_address & 0x001FFFF0u);
+            source != s.targets.end() && draw.texture_format <= 3u) {
+            texture_width = std::max<std::uint32_t>(1u, source->second.logical_width);
+            texture_height = std::max<std::uint32_t>(1u, source->second.logical_height);
+        }
+    }
+    const float su = sampled ? 1.0f / static_cast<float>(texture_width) : 1.0f;
+    const float sv = sampled ? 1.0f / static_cast<float>(texture_height) : 1.0f;
+    const std::uint32_t first = static_cast<std::uint32_t>(s.vertices.size());
+    s.vertices.resize(first + triangle_vertices.size());
+    Vertex *out = s.vertices.data() + first;
+    for (const GeGpuVertex &v : triangle_vertices)
+        *out++ = {v.x, v.y, v.z, v.w, v.rgba, v.u * su, v.v * sv, v.q, v.fog_factor};
+    Batch &batch = s.batches.emplace_back();
+    batch.draw = draw;
+    batch.texture_key = draw.texture_enabled ? texture_key(draw) : 0u;
+    batch.texture_ready = batch.texture_key != 0u && find_texture(s, batch.texture_key) != nullptr;
+    batch.first_vertex = first;
+    batch.vertex_count = static_cast<std::uint32_t>(triangle_vertices.size());
+    batch.feedback_address = draw.texture_address & 0x001FFFF0u;
+    batch.framebuffer_feedback = draw.texture_enabled && is_target_texture(s, draw);
+    ++s.report.game_draw_calls;
+    s.report.game_vertices += triangle_vertices.size();
+}
+
+namespace {
+
+// VCS_GLES_CULL=0: keep draws that are entirely off screen. GTA culls whole
+// objects; the meshes of a partly visible one all arrive here, and every one
+// costs the GE thread, a GL draw and vertex shading. A mesh whose model-space
+// bounding box is outside one clip plane draws nothing.
+bool cull_enabled() {
+    static const bool enabled = [] {
+        const char *text = std::getenv("VCS_GLES_CULL");
+        return text == nullptr || *text == '\0' || std::strcmp(text, "0") != 0;
+    }();
+    return enabled;
+}
+
+bool off_screen(const Gles2State &s, const GeGpuDrawDescriptor &draw, const GeGpuHardwareTransform &hw,
+                const std::array<float, 3> &low, const std::array<float, 3> &high) {
+    // Consecutive draws share a target: one hash find per target change.
+    static thread_local std::uint32_t cached_target = 0xFFFFFFFFu;
+    static thread_local std::uint64_t cached_epoch = 0u;
+    static thread_local std::uint32_t cached_width = kReferenceWidth;
+    static thread_local std::uint32_t cached_height = kReferenceHeight;
+    const std::uint32_t target_address = draw.framebuffer_address & 0x001FFFF0u;
+    if (target_address != cached_target || cached_epoch != s.frame_epoch) {
+        cached_target = target_address;
+        cached_epoch = s.frame_epoch;
+        cached_width = kReferenceWidth;
+        cached_height = kReferenceHeight;
+        if (const auto found = s.targets.find(target_address); found != s.targets.end()) {
+            cached_width = std::max<std::uint32_t>(1u, found->second.logical_width);
+            cached_height = std::max<std::uint32_t>(1u, found->second.logical_height);
+        }
+    }
+    const ClipRows rows = clip_rows(hw, cached_width, cached_height);
+    // Outside when all 8 corners are on the far side of one plane:
+    // w + x, w - x, w + y, w - y >= 0 and (depth clip) z >= 0, w - z >= 0.
+    std::uint32_t outside = 0x3Fu;
+    for (std::uint32_t corner = 0u; corner < 8u && outside != 0u; ++corner) {
+        const float p[4] = {(corner & 1u) ? high[0] : low[0], (corner & 2u) ? high[1] : low[1],
+                            (corner & 4u) ? high[2] : low[2], 1.0f};
+        const auto dot = [&](const std::array<float, 4> &row) {
+            return row[0] * p[0] + row[1] * p[1] + row[2] * p[2] + row[3] * p[3];
+        };
+        const float x = dot(rows[0]), y = dot(rows[1]), z = dot(rows[2]), w = dot(rows[3]);
+        std::uint32_t mask = 0u;
+        if (w + x < 0.0f) mask |= 1u;
+        if (w - x < 0.0f) mask |= 2u;
+        if (w + y < 0.0f) mask |= 4u;
+        if (w - y < 0.0f) mask |= 8u;
+        if (hw.depth_clip_enabled && z < 0.0f) mask |= 16u;
+        if (hw.depth_clip_enabled && w - z < 0.0f) mask |= 32u;
+        outside &= mask;
+    }
+    return outside != 0u;
+}
+
+// Appends a hardware-transform draw: fill(out) writes vertex_count vertices
+// straight into the frame's vertex array (no temporary per draw).
+template <typename Fill>
+void append_hardware_batch(Gles2State &s, const GeGpuDrawDescriptor &draw, const GeGpuHardwareTransform &transform,
+                           std::size_t vertex_count, std::span<const std::uint32_t> triangle_indices, Fill fill) {
+    const bool indexed = !triangle_indices.empty();
+    const std::size_t emitted = indexed ? triangle_indices.size() : vertex_count;
+    if (emitted == 0u || (transform.primitive == 4u ? emitted < 3u : (emitted % 3u) != 0u)) return;
+    if (s.vertices.size() + vertex_count > kMaxFrameVertices) {
+        ++s.report.game_vertex_overflows;
+        return;
+    }
+    if (indexed) {
+        std::uint32_t highest = 0u;
+        for (std::uint32_t index : triangle_indices) highest = std::max(highest, index);
+        if (highest >= vertex_count) {
+            ++s.report.game_vertex_overflows;
+            return;
+        }
+    }
+    const std::uint32_t first_vertex = static_cast<std::uint32_t>(s.vertices.size());
+    const std::uint32_t first_index = static_cast<std::uint32_t>(s.indices.size());
+    s.vertices.resize(first_vertex + vertex_count);
+    fill(s.vertices.data() + first_vertex);
+    if (cull_enabled() && !draw.clear_mode) {
+        std::array<float, 3> low{INFINITY, INFINITY, INFINITY};
+        std::array<float, 3> high{-INFINITY, -INFINITY, -INFINITY};
+        bool unit_w = true;  // the box test assumes w = 1 (model space)
+        for (std::size_t i = 0u; i < vertex_count; ++i) {
+            const Vertex &v = s.vertices[first_vertex + i];
+            low = {std::min(low[0], v.x), std::min(low[1], v.y), std::min(low[2], v.z)};
+            high = {std::max(high[0], v.x), std::max(high[1], v.y), std::max(high[2], v.z)};
+            unit_w &= v.w == 1.0f;
+        }
+        if (unit_w && low[0] <= high[0] && off_screen(s, draw, transform, low, high)) {
+            s.vertices.resize(first_vertex);
+            ++s.culled_draws;
+            s.culled_vertices += vertex_count;
+            return;
+        }
+    }
+    if (indexed) s.indices.insert(s.indices.end(), triangle_indices.begin(), triangle_indices.end());
+    Batch &batch = s.batches.emplace_back();
+    batch.draw = draw;
+    batch.texture_key = draw.texture_enabled ? texture_key(draw) : 0u;
+    batch.texture_ready = batch.texture_key != 0u && find_texture(s, batch.texture_key) != nullptr;
+    batch.first_vertex = first_vertex;
+    batch.vertex_count = static_cast<std::uint32_t>(vertex_count);
+    batch.first_index = first_index;
+    batch.index_count = indexed ? static_cast<std::uint32_t>(triangle_indices.size()) : 0u;
+    batch.indexed = indexed;
+    batch.logical_draw_count = std::max<std::uint32_t>(1u, transform.logical_prim_batches);
+    batch.hardware_transform = true;
+    batch.transform = transform;
+    batch.feedback_address = draw.texture_address & 0x001FFFF0u;
+    batch.framebuffer_feedback = draw.texture_enabled && is_target_texture(s, draw);
+    s.report.game_draw_calls += batch.logical_draw_count;
+    s.report.hw_transform_draw_calls += batch.logical_draw_count;
+    s.report.game_vertices += emitted;
+}
+
+// The indices are 0..count-1: the vertices draw in stream order.
+bool identity_indices(std::span<const std::uint32_t> indices, std::uint32_t count) {
+    if (indices.size() != count) return false;
+    for (std::uint32_t i = 0u; i < count; ++i)
+        if (indices[i] != i) return false;
+    return true;
+}
+
+}  // namespace
+
+void ge_gpu_backend_accumulate_hardware_triangles(
+    const GeGpuDrawDescriptor &draw, const GeGpuHardwareTransform &transform,
+    std::span<const GeGpuVertex> vertices, std::span<const std::uint32_t> triangle_indices) noexcept {
+    Gles2State &s = state();
+    std::lock_guard<std::recursive_mutex> guard(s.mutex);
+    if (!s.enabled || vertices.empty()) return;
+    append_hardware_batch(s, draw, transform, vertices.size(), triangle_indices, [&](Vertex *out) {
+        for (const GeGpuVertex &v : vertices)
+            *out++ = {v.x, v.y, v.z, v.w, v.rgba, v.u, v.v, v.q, v.fog_factor};
+    });
+}
+
+bool ge_gpu_backend_accumulate_hardware_packed_0115(
+    const GeGpuDrawDescriptor &draw, const GeGpuHardwareTransform &transform,
+    std::span<const std::byte> packed_vertices, std::uint32_t vertex_count,
+    std::span<const std::uint32_t> triangle_indices) noexcept {
+    Gles2State &s = state();
+    std::lock_guard<std::recursive_mutex> guard(s.mutex);
+    if (!s.enabled || vertex_count == 0u ||
+        packed_vertices.size() != static_cast<std::size_t>(vertex_count) * sizeof(Packed0115))
+        return false;
+    // Kept as the PSP stores them; the vertex shader decodes them.
+    const bool indexed = !triangle_indices.empty();
+    const std::size_t emitted = indexed ? triangle_indices.size() : vertex_count;
+    if (emitted == 0u || (transform.primitive == 4u ? emitted < 3u : (emitted % 3u) != 0u)) return true;
+    // VCS_GLES_STRIP_RUNS: a strip drawn in stream order (Batch::strip_run)
+    // that follows another packed one ending where it starts gets the
+    // degenerate vertices joining the two in the stream itself: the previous
+    // strip's last vertex and its own first, plus the first once more when
+    // the previous strip's length is odd (append_strip's rule, so every
+    // triangle keeps its winding whichever strip starts the merged group).
+    const bool strip_run = transform.primitive == 4u && s.render.strip_runs && s.render.strips &&
+                           (!indexed || identity_indices(triangle_indices, vertex_count));
+    std::uint32_t join = 0u;
+    if (strip_run && !s.batches.empty()) {
+        const Batch &previous = s.batches.back();
+        if (previous.strip_run && previous.packed &&
+            static_cast<std::size_t>(previous.first_vertex + previous.vertex_count) * sizeof(Packed0115) == s.packed.size())
+            join = 2u + (previous.vertex_count & 1u);
+    }
+    if (s.packed.size() / sizeof(Packed0115) + join + vertex_count > kMaxFrameVertices) {
+        ++s.report.game_vertex_overflows;
+        return true;
+    }
+    if (indexed) {
+        std::uint32_t highest = 0u;
+        for (std::uint32_t index : triangle_indices) highest = std::max(highest, index);
+        if (highest >= vertex_count) {
+            ++s.report.game_vertex_overflows;
+            return true;
+        }
+    }
+    const auto *bytes = reinterpret_cast<const std::uint8_t *>(packed_vertices.data());
+    if (cull_enabled() && !draw.clear_mode) {
+        std::int16_t low[3] = {INT16_MAX, INT16_MAX, INT16_MAX};
+        std::int16_t high[3] = {INT16_MIN, INT16_MIN, INT16_MIN};
+        const std::size_t count = vertex_count;
+        std::size_t i = 0u;
+#if defined(__ARM_NEON)
+        // Four halfwords at a time: x, y, z and the next vertex's first two
+        // bytes (lane 3, ignored). The last vertex is done below so nothing is
+        // read past the end of the data. Two pairs of accumulators hide the
+        // vmin/vmax latency.
+        if (count >= 3u) {
+            int16x4_t lo0 = vdup_n_s16(INT16_MAX), hi0 = vdup_n_s16(INT16_MIN);
+            int16x4_t lo1 = lo0, hi1 = hi0;
+            const std::size_t pairs_end = count - 1u;
+            for (; i + 2u <= pairs_end; i += 2u) {
+                const int16x4_t a = vld1_s16(reinterpret_cast<const std::int16_t *>(bytes + i * sizeof(Packed0115) + 4u));
+                const int16x4_t b = vld1_s16(reinterpret_cast<const std::int16_t *>(bytes + (i + 1u) * sizeof(Packed0115) + 4u));
+                lo0 = vmin_s16(lo0, a); hi0 = vmax_s16(hi0, a);
+                lo1 = vmin_s16(lo1, b); hi1 = vmax_s16(hi1, b);
+            }
+            for (; i < pairs_end; ++i) {
+                const int16x4_t a = vld1_s16(reinterpret_cast<const std::int16_t *>(bytes + i * sizeof(Packed0115) + 4u));
+                lo0 = vmin_s16(lo0, a); hi0 = vmax_s16(hi0, a);
+            }
+            lo0 = vmin_s16(lo0, lo1); hi0 = vmax_s16(hi0, hi1);
+            std::int16_t l[4], h[4];
+            vst1_s16(l, lo0); vst1_s16(h, hi0);
+            for (int c = 0; c < 3; ++c) { low[c] = l[c]; high[c] = h[c]; }
+        }
+#endif
+        for (; i < count; ++i) {
+            std::int16_t p[3];
+            std::memcpy(p, bytes + i * sizeof(Packed0115) + 4u, sizeof(p));
+            for (int c = 0; c < 3; ++c) {
+                low[c] = std::min(low[c], p[c]);
+                high[c] = std::max(high[c], p[c]);
+            }
+        }
+        constexpr float k = 1.0f / 32768.0f;
+        if (off_screen(s, draw, transform, {low[0] * k, low[1] * k, low[2] * k}, {high[0] * k, high[1] * k, high[2] * k})) {
+            ++s.culled_draws;
+            s.culled_vertices += vertex_count;
+            return true;
+        }
+    }
+    // The array also holds raw blocks of other strides: start on a whole
+    // 10-byte vertex (first_vertex counts those).
+    const std::size_t padded = (s.packed.size() + sizeof(Packed0115) - 1u) / sizeof(Packed0115) * sizeof(Packed0115);
+    s.packed.resize(padded);
+    if (join != 0u) {
+        // padded is the previous strip's end: the joining vertices go there.
+        s.packed.resize(padded + static_cast<std::size_t>(join) * sizeof(Packed0115));
+        std::uint8_t *at = s.packed.data() + padded;
+        std::memcpy(at, at - sizeof(Packed0115), sizeof(Packed0115));
+        for (std::uint32_t i = 1u; i < join; ++i) std::memcpy(at + i * sizeof(Packed0115), bytes, sizeof(Packed0115));
+    }
+    const std::uint32_t first_vertex = static_cast<std::uint32_t>(padded / sizeof(Packed0115) + join);
+    const std::uint32_t first_index = static_cast<std::uint32_t>(s.indices.size());
+    s.packed.insert(s.packed.end(), bytes, bytes + packed_vertices.size());
+    if (indexed) s.indices.insert(s.indices.end(), triangle_indices.begin(), triangle_indices.end());
+    Batch &batch = s.batches.emplace_back();
+    batch.draw = draw;
+    batch.texture_key = draw.texture_enabled ? texture_key(draw) : 0u;
+    batch.texture_ready = batch.texture_key != 0u && find_texture(s, batch.texture_key) != nullptr;
+    batch.first_vertex = first_vertex;
+    batch.vertex_count = vertex_count;
+    batch.first_index = first_index;
+    batch.index_count = indexed ? static_cast<std::uint32_t>(triangle_indices.size()) : 0u;
+    batch.indexed = indexed;
+    batch.logical_draw_count = std::max<std::uint32_t>(1u, transform.logical_prim_batches);
+    batch.hardware_transform = true;
+    batch.packed = true;
+    batch.strip_run = strip_run;
+    batch.strip_join = static_cast<std::uint8_t>(join);
+    batch.transform = transform;
+    batch.feedback_address = draw.texture_address & 0x001FFFF0u;
+    batch.framebuffer_feedback = draw.texture_enabled && is_target_texture(s, draw);
+    s.report.game_draw_calls += batch.logical_draw_count;
+    s.report.hw_transform_draw_calls += batch.logical_draw_count;
+    s.report.game_vertices += emitted;
+    return true;
+}
+
+bool ge_gpu_backend_accumulate_hardware_raw(
+    const GeGpuDrawDescriptor &draw, const GeGpuHardwareTransform &transform,
+    const GeGpuRawLayout &layout, std::span<const std::byte> raw_vertices, std::uint32_t vertex_count,
+    std::span<const std::uint32_t> triangle_indices, const GeGpuRawState &raw_state,
+    bool state_changed) noexcept {
+    Gles2State &s = state();
+    if (!s.enabled || vertex_count == 0u || layout.stride == 0u ||
+        raw_vertices.size() != static_cast<std::size_t>(vertex_count) * layout.stride)
+        return false;
+    const bool indexed = !triangle_indices.empty();
+    const std::size_t emitted = indexed ? triangle_indices.size() : vertex_count;
+    if (emitted == 0u || (transform.primitive == 4u ? emitted < 3u : (emitted % 3u) != 0u)) return true;
+    // As the packed path: a strip in stream order may get the vertices
+    // joining it to the previous batch's strip (same layout and state, ending
+    // where this one starts); at most three more vertices.
+    const bool strip_run = transform.primitive == 4u && s.render.strip_runs && s.render.strips &&
+                           (!indexed || identity_indices(triangle_indices, vertex_count));
+    if (s.packed.size() + raw_vertices.size() + (strip_run ? 3u * layout.stride : 0u) >
+            kMaxFrameVertices * sizeof(Packed0115) || vertex_count > 65536u) {
+        ++s.report.game_vertex_overflows;
+        return true;
+    }
+    if (indexed) {
+        std::uint32_t highest = 0u;
+        for (std::uint32_t index : triangle_indices) highest = std::max(highest, index);
+        if (highest >= vertex_count) {
+            ++s.report.game_vertex_overflows;
+            return true;
+        }
+    }
+    // Each element must stay aligned to its type in the frame array (the
+    // PSP layout aligns them within a vertex): the block starts aligned to
+    // the widest element.
+    const auto width = [](std::uint32_t type) { return type == 3u ? 4u : type == 2u ? 2u : 1u; };
+    std::uint32_t alignment = std::max({width(layout.position_type), width(layout.normal_type),
+                                        width(layout.tc_type), width(layout.weight_type)});
+    if (layout.color_type == 7u) alignment = 4u;
+    else if (layout.color_type >= 4u) alignment = std::max(alignment, 2u);
+    const std::size_t padded = (s.packed.size() + alignment - 1u) & ~static_cast<std::size_t>(alignment - 1u);
+    const auto *bytes = reinterpret_cast<const std::uint8_t *>(raw_vertices.data());
+    std::uint32_t join = 0u;
+    if (strip_run && !state_changed && !s.batches.empty()) {
+        const Batch &previous = s.batches.back();
+        if (previous.strip_run && previous.raw && previous.raw_layout == layout && padded == s.packed.size() &&
+            previous.first_vertex + static_cast<std::size_t>(previous.vertex_count) * layout.stride == padded)
+            join = 2u + (previous.vertex_count & 1u);
+    }
+    s.packed.resize(padded + static_cast<std::size_t>(join) * layout.stride);
+    if (join != 0u) {
+        std::uint8_t *at = s.packed.data() + padded;
+        std::memcpy(at, at - layout.stride, layout.stride);
+        for (std::uint32_t i = 1u; i < join; ++i) std::memcpy(at + i * layout.stride, bytes, layout.stride);
+    }
+    const std::uint32_t first_vertex = static_cast<std::uint32_t>(padded + join * layout.stride);
+    const std::uint32_t first_index = static_cast<std::uint32_t>(s.indices.size());
+    s.packed.insert(s.packed.end(), bytes, bytes + raw_vertices.size());
+    if (indexed) s.indices.insert(s.indices.end(), triangle_indices.begin(), triangle_indices.end());
+    if (state_changed || s.raw_states.empty()) s.raw_states.push_back(raw_state);
+    Batch &batch = s.batches.emplace_back();
+    batch.draw = draw;
+    batch.transform = transform;
+    batch.texture_key = draw.texture_enabled ? texture_key(draw) : 0u;
+    batch.texture_ready = batch.texture_key != 0u && find_texture(s, batch.texture_key) != nullptr;
+    batch.first_vertex = first_vertex;
+    batch.vertex_count = vertex_count;
+    batch.first_index = first_index;
+    batch.index_count = indexed ? static_cast<std::uint32_t>(triangle_indices.size()) : 0u;
+    batch.indexed = indexed;
+    batch.logical_draw_count = std::max<std::uint32_t>(1u, transform.logical_prim_batches);
+    batch.hardware_transform = true;
+    batch.raw = true;
+    batch.raw_layout = layout;
+    batch.raw_state = static_cast<std::uint32_t>(s.raw_states.size() - 1u);
+    batch.strip_run = strip_run;
+    batch.strip_join = static_cast<std::uint8_t>(join);
+    batch.feedback_address = draw.texture_address & 0x001FFFF0u;
+    batch.framebuffer_feedback = draw.texture_enabled && is_target_texture(s, draw);
+    s.report.game_draw_calls += batch.logical_draw_count;
+    s.report.hw_transform_draw_calls += batch.logical_draw_count;
+    s.report.game_vertices += emitted;
+    return true;
+}
+
+void ge_gpu_backend_set_native_window(void *) noexcept {}
+
+void ge_gpu_backend_set_display_framebuffer(std::uint32_t address) noexcept {
+    Gles2State &s = state();
+    std::lock_guard<std::recursive_mutex> guard(s.mutex);
+    s.display_framebuffer = address & 0x001FFFF0u;
+    if (!s.enabled) return;
+    note_target(s, s.display_framebuffer, s.display_logical_width, s.display_logical_height, s.display_logical_width);
+}
+
+bool ge_gpu_backend_finish_color_frame(std::uint64_t vblank) noexcept {
+    Gles2State &s = state();
+    std::lock_guard<std::recursive_mutex> guard(s.mutex);
+    const bool publish = true;
+    if (!s.enabled || (s.batches.empty() && s.uploads.empty() && s.deletes.empty())) {
+        s.vertices.clear();
+        s.packed.clear();
+        s.indices.clear();
+        s.batches.clear();
+        ++s.frame_epoch;
+        if (s.vblanks_since_gpu_frame != ~0u) ++s.vblanks_since_gpu_frame;
+        return false;
+    }
+    evict_textures(s);
+    // The frame shown is the target with the most geometry, as in the Vulkan
+    // backend: VCS draws its scene and HUD into a working buffer and copies
+    // that into the displayed one with a quad. Last frame's pick is kept
+    // until another target has 1.5 times its vertices, so two targets of
+    // similar size do not alternate.
+    std::uint64_t psp_draws = 0u;
+    std::unordered_map<std::uint32_t, std::uint64_t> geometry;
+    for (const Batch &batch : s.batches) {
+        psp_draws += batch.logical_draw_count;
+        geometry[batch.draw.framebuffer_address & 0x001FFFF0u] += batch.vertex_count + batch.index_count;
+    }
+    std::uint32_t largest = 0u;
+    std::uint64_t largest_geometry = 0u;
+    for (const auto &[address, count] : geometry)
+        if (count > largest_geometry) { largest = address; largest_geometry = count; }
+    const auto sticky = geometry.find(s.last_winner);
+    std::uint32_t winner =
+        (sticky != geometry.end() && largest_geometry * 2u < sticky->second * 3u) ? s.last_winner : largest;
+    // A vblank that did not draw the last winner but only a small target
+    // (VCS copying its working buffer into the displayed one, a few quads)
+    // is not shown: the screen keeps the last frame. Showing it alternated
+    // the scene with that copy every frame. A target that keeps winning for
+    // 8 vblanks takes over (menus, a new working buffer).
+    bool touched_display = largest_geometry != 0u;
+    if (touched_display && sticky == geometry.end() && s.last_winner_geometry != 0u &&
+        largest_geometry * 2u < s.last_winner_geometry) {
+        if (++s.small_frames < 8u) touched_display = false;
+    } else {
+        s.small_frames = 0u;
+    }
+    static const bool target_log = std::getenv("VCS_GLES_TARGET_LOG") != nullptr;
+    if (target_log) {
+        std::fprintf(stderr, "glos: targets vblank %llu shown %08x%s:", static_cast<unsigned long long>(vblank),
+                     touched_display ? winner : 0u, touched_display ? "" : " (kept)");
+        for (const auto &[address, count] : geometry)
+            std::fprintf(stderr, " %08x=%llu", address, static_cast<unsigned long long>(count));
+        if (const auto shown = s.frame_extents.find(winner); shown != s.frame_extents.end())
+            std::fprintf(stderr, " size %ux%u", std::max(shown->second.width, std::min(shown->second.stride, kReferenceWidth)),
+                         std::max(shown->second.height, kReferenceHeight));
+        std::fprintf(stderr, "\n");
+    }
+    if (touched_display) {
+        s.last_winner = winner;
+        s.last_winner_geometry = geometry[winner];
+        s.small_frames = 0u;
+    }
+    std::unique_ptr<Frame> frame = take_frame(s);
+    frame->guest = false;
+    frame->vertices.swap(s.vertices);
+    frame->packed.swap(s.packed);
+    frame->indices.swap(s.indices);
+    frame->batches.swap(s.batches);
+    frame->raw_states.swap(s.raw_states);
+    frame->uploads.swap(s.uploads);
+    frame->deletes.swap(s.deletes);
+    for (const auto &[address, extent] : s.frame_extents) {
+        TargetSize &target = s.targets[address];
+        target.logical_width = std::max(extent.width, std::min(extent.stride, kReferenceWidth));
+        target.logical_height = std::max(extent.height, kReferenceHeight);
+    }
+    s.frame_extents.clear();
+    frame->targets.clear();
+    for (const auto &entry : s.targets) frame->targets.push_back(entry.second);
+    frame->display_framebuffer = touched_display ? winner : s.display_framebuffer;
+    frame->display_logical_width = s.display_logical_width;
+    frame->display_logical_height = s.display_logical_height;
+    frame->publish = publish && touched_display;
+    frame->display_aspect = resolve_widescreen_aspect_ratio(vcs_configuration(), 0u, 0u);
+    frame->psp_draws = psp_draws;
+    frame->culled_draws = s.culled_draws;
+    frame->culled_vertices = s.culled_vertices;
+    s.culled_draws = s.culled_vertices = 0u;
+    // The swaps left the spare frame's (empty) buffers here, capacity and all.
+    s.vertices.clear();
+    s.packed.clear();
+    s.indices.clear();
+    s.batches.clear();
+    s.uploads.clear();
+    s.deletes.clear();
+    submit_frame(s, std::move(frame));
+    ++s.report.game_frames;
+    s.report.game_frame_vblank = vblank;
+    s.report.presented_framebuffer_target = touched_display ? winner : 0u;
+    if (!touched_display) ++s.report.frames_without_displayed_target;
+    ++s.frame_epoch;
+    if (publish && touched_display) s.vblanks_since_gpu_frame = 0u;
+    else if (s.vblanks_since_gpu_frame != ~0u) ++s.vblanks_since_gpu_frame;
+    return publish && touched_display;
+}
+
+bool ge_gpu_backend_copy_game_frame_rgba(std::span<std::byte>) noexcept { return false; }
+
+// While the GE draws (VCS fills the display every other vblank) the render
+// thread shows its frames and the vblanks between keep the last one. After
+// a few vblanks without one (movies, loading screens) the profile presents
+// the guest framebuffer, which comes back through present_rgba.
+bool ge_gpu_backend_presents_directly() noexcept {
+    const Gles2State &s = state();
+    return s.enabled && s.vblanks_since_gpu_frame <= 4u;
+}
+
+// Frames the game writes to PSP memory itself (movies, loading screens).
+// Drawn by the render thread, in order with the GE frames.
+bool ge_gpu_backend_present_rgba(std::span<const std::byte> rgba, std::uint32_t width,
+                                 std::uint32_t height, bool) noexcept {
+    Gles2State &s = state();
+    if (!s.enabled || width == 0u || height == 0u ||
+        rgba.size() < static_cast<std::size_t>(width) * height * 4u)
+        return false;
+    std::unique_ptr<Frame> frame = take_frame(s);
+    frame->guest = true;
+    frame->guest_rgba.assign(rgba.begin(), rgba.begin() + static_cast<std::ptrdiff_t>(width) * height * 4);
+    frame->guest_width = width;
+    frame->guest_height = height;
+    submit_frame(s, std::move(frame));
+    return true;
+}
+
+void ge_gpu_backend_lock() noexcept { state().mutex.lock(); }
+void ge_gpu_backend_unlock() noexcept { state().mutex.unlock(); }
+bool ge_gpu_backend_is_vulkan() noexcept { return false; }
+bool ge_gpu_backend_owns_window() noexcept { return state().enabled; }
+std::uint32_t ge_gpu_backend_last_winner_target() noexcept { return state().last_winner; }
+const char *ge_gpu_backend_name(GeGpuBackendKind kind) noexcept {
+    switch (kind) {
+    case GeGpuBackendKind::Software: return "Software";
+    case GeGpuBackendKind::DirectX12: return "DirectX12";
+    case GeGpuBackendKind::Vulkan: return "GLES2";
+    }
+    return "Unknown";
+}
+
+std::uint32_t ge_gpu_backend_owned_framebuffer() noexcept {
+    const Gles2State &s = state();
+    return s.enabled ? s.display_framebuffer : 0u;
+}
+std::uint32_t ge_gpu_backend_display_framebuffer() noexcept { return state().display_framebuffer; }
+std::span<const std::byte> ge_gpu_backend_game_frame_rgba() noexcept { return {}; }
+bool ge_gpu_backend_copy_offscreen_rgba(std::span<std::byte>) noexcept { return false; }
+void ge_gpu_backend_mark_window_presented() noexcept { state().report.gpu_frame_presented_to_window = true; }
+GeGpuBackendReport ge_gpu_backend_report() {
+    Gles2State &s = state();
+    std::lock_guard<std::recursive_mutex> guard(s.mutex);
+    return s.report;
+}
