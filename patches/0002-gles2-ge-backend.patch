 namespace vcs {
 
+// std::vector whose resize() leaves new elements uninitialised: the per-draw
+// vertex and index buffers are resized and then fully overwritten, and the zero
+// fill was a share of the GE thread's memset time (ga36-lcs-recomp-port 0017).
+template <typename T>
+struct DefaultInitAllocator : std::allocator<T> {
+    using std::allocator<T>::allocator;
+    template <typename U> struct rebind { using other = DefaultInitAllocator<U>; };
+    template <typename U> void construct(U *p) noexcept(std::is_nothrow_default_constructible_v<U>) { ::new (static_cast<void *>(p)) U; }
+    template <typename U, typename... Args> void construct(U *p, Args &&...args) { ::new (static_cast<void *>(p)) U(std::forward<Args>(args)...); }
+};
