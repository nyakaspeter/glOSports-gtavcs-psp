+bool fbdev_size(std::uint32_t &width, std::uint32_t &height) {
+    const int fd = open("/dev/fb0", O_RDONLY);
+    if (fd < 0) return false;
+    fb_var_screeninfo info{};
+    const bool ok = ioctl(fd, FBIOGET_VSCREENINFO, &info) == 0;
+    close(fd);
+    if (!ok || info.xres == 0u || info.yres == 0u) return false;
+    width = info.xres;
+    height = info.yres;
+    return true;
+}
