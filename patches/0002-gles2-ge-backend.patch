index 0000000..6874e03
--- /dev/null
+++ b/profiles/vcs/host/ge_gpu_backend_gles2.cpp
@@ -0,0 +1,3865 @@
+#include "ge_gpu_backend.hpp"
+
+// GE backend on OpenGL ES 2.0 for GPUs without Vulkan, written for ARM's
+// closed Mali-400 driver (r6p2), whose only output is EGL on /dev/fb0.
+// It follows the Vulkan backend's model: one render target (colour texture,
+// depth renderbuffer, FBO) per PSP framebuffer address, the frame's draws
+// replayed at the frame's end, and the display target scaled onto the screen.
+// It only starts when /dev/mali exists (ARM's driver loaded, as under
+// "glos-gpu run mali"); otherwise the software rasterizer stays active.
+//
+// Two threads. The GE thread (the backend API) only collects a frame:
+// vertices, draws, decoded textures, render-target sizes. At the frame's end
+// it hands the whole frame to the render thread, which owns the EGL context
+// and every GL object, and goes on with the next frame while that one is
+// drawn: on the Mali-400 the driver work per frame is as large as the GE
+// work, so the two overlap. Nothing is shared between them but the frame
+// queue (one frame waiting, one drawing); guest frames (movies) go through it
+// too, so they stay in order.
+#if defined(VCS_GLES2_GE_BACKEND)
+
+#include "vcs_config.hpp"
+#include "vcs_runtime_log.hpp"
+
+#define EGL_NO_X11 1
+#if defined(__ARM_NEON)
+#include <arm_neon.h>
+#endif
+#include <EGL/egl.h>
+#include <GLES2/gl2.h>
+#include <GLES2/gl2ext.h>
+
+#include <fcntl.h>
+#include <linux/fb.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <condition_variable>
+#include <cstddef>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include <vector>
+
+namespace vcs {
+namespace {
+
+using Index16Vector = std::vector<std::uint16_t, DefaultInitAllocator<std::uint16_t>>;
+
+constexpr std::uint32_t kReferenceWidth = 480u;
+constexpr std::uint32_t kReferenceHeight = 272u;
+constexpr std::size_t kMaxFrameVertices = 1u << 20u;
+// Decoded textures kept on the GPU before least-recently-used ones go.
+constexpr std::size_t kTextureBudgetBytes = 48u * 1024u * 1024u;
+
+// ARM's fbdev native window type (EGL/fbdev_window.h).
+struct FbdevWindow {
+    unsigned short width;
+    unsigned short height;
+};
+
+struct Vertex {
+    float x{};
+    float y{};
+    float z{};
+    float w{1.0f};
+    std::uint32_t rgba{0xFFFFFFFFu};
+    float u{};
+    float v{};
+    float q{1.0f};
+    float fog{1.0f};
+};
+static_assert(sizeof(Vertex) == 36u);
+
+#pragma pack(push, 1)
+struct Packed0115 {
+    std::uint8_t u{};
+    std::uint8_t v{};
+    std::uint16_t color{};
+    std::int16_t x{};
+    std::int16_t y{};
+    std::int16_t z{};
+};
+#pragma pack(pop)
+static_assert(sizeof(Packed0115) == 10u);
+
+struct Batch {
+    GeGpuDrawDescriptor draw{};
+    std::uint64_t texture_key{};
+    std::uint32_t first_vertex{};
+    std::uint32_t vertex_count{};
+    std::uint32_t first_index{};
+    std::uint32_t index_count{};
+    bool indexed{};
+    std::uint32_t logical_draw_count{1u};
+    bool hardware_transform{};
+    // first_vertex/vertex_count index the frame's packed 0115 vertices.
+    bool packed{};
+    // Hardware-transform vertices already transformed to clip space on the
+    // CPU (see pretransform), so the draw needs no per-draw matrices.
+    bool pretransformed{};
+    GeGpuHardwareTransform transform{};
+    bool framebuffer_feedback{};
+    std::uint32_t feedback_address{};
+    // Raw vertices (see GeGpuRawLayout): first_vertex is their byte offset in
+    // the frame's packed array; raw_state indexes the frame's raw states.
+    bool raw{};
+    GeGpuRawLayout raw_layout{};
+    std::uint32_t raw_state{};
+    // The texture is uploaded (or in this frame's uploads): the merge loop
+    // picks the textured program without the render thread's map.
+    bool texture_ready{};
+    // VCS_GLES_STRIP_RUNS: a strip whose vertices draw in stream order (not
+    // indexed, or indexed 0..n-1), and how many degenerate vertices (0, 2 or
+    // 3) sit in the stream right before first_vertex to join it to the
+    // previous batch's strip (see accumulate_hardware_packed_0115).
+    bool strip_run{};
+    std::uint8_t strip_join{};
+};
+
+// Uniforms: the vertex shader's are the array uV[UVertexCount], the fragment
+// shader's uF (UFragmentCount), each sent with one call and only when changed
+// (driver calls per draw are what the Mali-400 path pays for).
+enum Uniform : int {
+    URow0, URow1, URow2, URow3, UViewZ, UUv, UFog, UMul, UAdd, UFlags,
+    UEnv, UFogColor, UAlphaRef, UTexture
+};
+constexpr int UVertexCount = UEnv;
+constexpr int UFragmentCount = UTexture - UEnv;
+using UniformValues = std::array<std::array<float, 4>, UTexture>;
+
+// Keys only, no GL objects: the merge loop that builds these runs on the
+// transform thread; the render thread resolves them when it draws.
+enum TextureKind : std::uint8_t { TexNone, TexKey, TexFeedback, TexSnapshot };
+struct DrawState {
+    std::uint32_t target{};          // PSP framebuffer address
+    std::array<GLint, 4> scissor{};
+    std::uint64_t program{};
+    std::uint8_t texture_kind{};     // TextureKind
+    std::uint64_t texture_key{};     // TexKey: the decoded texture; TexFeedback: its target address
+    std::uint32_t sampler{};         // wrap/filter bits
+    std::uint32_t fixed{};           // depth/blend/colour-mask/cull bits
+    std::uint32_t blend_color{};
+    UniformValues uniforms{};
+    std::uint32_t raw_state{};       // raw draws: index of the frame's uR block
+    GeGpuRawLayout raw_layout{};
+};
+
+bool same_state(const DrawState &a, const DrawState &b) {
+    return a.target == b.target && a.scissor == b.scissor && a.program == b.program &&
+           a.texture_kind == b.texture_kind && a.texture_key == b.texture_key &&
+           a.sampler == b.sampler && a.fixed == b.fixed &&
+           a.blend_color == b.blend_color && a.uniforms == b.uniforms &&
+           a.raw_state == b.raw_state && a.raw_layout == b.raw_layout;
+}
+
+// One step of a frame: a merged draw, or a snapshot of a target that a later
+// draw samples while rendering to it.
+struct Command {
+    DrawState state{};
+    std::uint32_t snapshot{0xFFFFFFFFu};  // set: copy this target to its snapshot texture
+    std::uint32_t base{};     // first vertex (in the packed or float array)
+    std::uint32_t first_index{};
+    std::uint32_t index_count{};
+    std::uint32_t first_vertex{};  // arrays: the run starts here (relative to base)
+    bool strip{};             // one triangle strip (draws joined by degenerate triangles)
+    bool arrays{};            // the indices are one sequential run: glDrawArrays
+};
+
+// ------------------------------------------------------------------ frames --
+
+struct TargetSize {
+    std::uint32_t address{};
+    std::uint32_t logical_width{kReferenceWidth};
+    std::uint32_t logical_height{kReferenceHeight};
+};
+
+struct UploadJob;
+
+struct TextureUpload {
+    std::uint64_t key{};
+    std::uint32_t width{};
+    std::uint32_t height{};
+    std::uint32_t mip_levels{1u};
+    std::vector<std::byte> rgba8;
+    // VCS_GLES_UPLOAD_THREAD: the upload thread's job (which holds the
+    // pixels; rgba8 is then empty).
+    std::shared_ptr<UploadJob> job;
+};
+
+// One frame, handed from the GE thread to the render thread.
+struct Frame {
+    bool guest{};  // a guest (movie) frame: only guest_rgba
+    std::vector<Vertex, DefaultInitAllocator<Vertex>> vertices;
+    std::vector<std::uint8_t> packed;  // 0115 vertices, 10 bytes each, as the PSP stores them
+    std::vector<std::uint32_t> indices;
+    std::vector<Batch> batches;
+    std::vector<GeGpuRawState> raw_states;
+    std::vector<TextureUpload> uploads;
+    std::vector<std::uint64_t> deletes;
+    std::vector<TargetSize> targets;
+    std::uint32_t display_framebuffer{};
+    std::uint32_t display_logical_width{kReferenceWidth};
+    std::uint32_t display_logical_height{kReferenceHeight};
+    bool publish{};
+    float display_aspect{};  // >0: the aspect to show the frame at (Widescreen.AspectRatio)
+    std::uint64_t psp_draws{};
+    std::uint64_t culled_draws{};     // dropped as entirely off screen (GE side)
+    std::uint64_t culled_vertices{};
+    std::vector<std::byte> guest_rgba;
+    std::uint32_t guest_width{};
+    std::uint32_t guest_height{};
+    // The merge loop's output (merge_frame): GL draws and their 16-bit
+    // indices, built on the transform thread.
+    std::vector<Command> commands;
+    Index16Vector index16;
+    std::array<std::uint64_t, 13> breaks{};
+    bool merged{};
+    bool touched_display{};
+
+    void clear() {
+        guest = false;
+        vertices.clear();
+        packed.clear();
+        indices.clear();
+        raw_states.clear();
+        batches.clear();
+        commands.clear();
+        index16.clear();
+        breaks = {};
+        merged = false;
+        touched_display = false;
+        uploads.clear();
+        deletes.clear();
+        targets.clear();
+        psp_draws = 0u;
+        guest_rgba.clear();
+    }
+};
+
+// ------------------------------------------------------------ render side --
+
+struct Target {
+    std::uint32_t address{};
+    std::uint32_t logical_width{kReferenceWidth};
+    std::uint32_t logical_height{kReferenceHeight};
+    GLuint color{};
+    GLuint snapshot{};
+    GLuint depth{};
+    GLuint fbo{};
+    std::uint64_t last_render_epoch{};
+};
+
+struct GlTexture {
+    GLuint id{};
+    std::uint32_t mip_levels{1u};
+    std::uint32_t width{};
+    std::uint32_t height{};
+    bool pot{};
+    // Texture parameters last set on it (GLES 2 has no sampler objects).
+    GLint wrap_s{};
+    GLint wrap_t{};
+    GLint min_filter{};
+    GLint mag_filter{};
+};
+
+// VCS_GLES_UPLOAD_THREAD: a decoded texture handed to the upload thread, which
+// uploads it on its own context (sharing the render context's objects). The
+// render thread adopts the result when the frame that needs it comes; a job
+// the upload thread hasn't started by then it takes over and uploads itself.
+enum UploadJobState : std::uint8_t { JobQueued, JobUploading, JobDone, JobRender };
+struct UploadJob {
+    std::atomic<std::uint8_t> state{JobQueued};
+    TextureUpload upload;
+    GlTexture texture;  // set by the upload thread (JobDone)
+};
+
+// Texture objects freed on the render thread, kept for reuse by shape
+// (VCS_GLES_TEXTURE_POOL): new textures go into them with glTexSubImage2D
+// instead of a new GPU allocation (ARM's driver maps fresh memory for every
+// glTexImage2D). The pixel format is always RGBA8, so the shape is size and
+// level count. Shared with the upload thread, under its own mutex.
+struct PooledTexture {
+    GLuint id{};
+    std::uint32_t width{};
+    std::uint32_t height{};
+    std::uint32_t levels{};
+    std::size_t bytes{};
+    std::uint64_t reusable_at{};  // render frames done: earlier frames may still sample it
+};
+constexpr std::size_t kPoolMaxTextures = 64u;
+constexpr std::size_t kPoolMaxBytes = 8u * 1024u * 1024u;
+constexpr std::uint64_t kPoolReuseFrames = 3u;
+
+// What the render thread shares with the upload thread: the pool, the job
+// queue, and counters for VCS_FPS_LOG.
+struct SharedTextures {
+    bool pool_enabled{};
+    std::mutex pool_mutex;
+    std::deque<PooledTexture> pool;  // oldest first
+    std::size_t pool_bytes{};
+    std::atomic<std::uint64_t> render_frames{};
+    std::atomic<std::uint64_t> pool_hits{};
+    std::atomic<std::uint64_t> allocations{};
+    // The upload thread's queue (GE thread -> upload thread).
+    std::mutex mutex;
+    std::condition_variable cv;       // jobs queued, or stop
+    std::condition_variable done_cv;  // jobs done
+    std::deque<std::shared_ptr<UploadJob>> queue;
+    bool stop{};
+    std::atomic<bool> failed{};  // the upload thread couldn't make its context current
+};
+
+struct Program {
+    GLuint id{};
+    GLint vertex_location{-1};
+    GLint fragment_location{-1};
+    GLint raw_location{-1};
+    UniformValues sent{};
+    bool vertex_valid{};
+    bool fragment_valid{};
+    std::uint64_t raw_sent_epoch{};  // frame epoch and index of the uR block last sent
+    std::uint32_t raw_sent_state{};
+};
+
+// Everything on the render thread; nothing else touches it (but `shared`,
+// see SharedTextures).
+struct RenderState {
+    EGLDisplay display{EGL_NO_DISPLAY};
+    EGLSurface surface{EGL_NO_SURFACE};
+    EGLContext context{EGL_NO_CONTEXT};
+    // VCS_GLES_UPLOAD_THREAD: the upload thread's context (sharing context's
+    // objects) and its pbuffer (none with EGL_KHR_surfaceless_context).
+    EGLContext upload_context{EGL_NO_CONTEXT};
+    EGLSurface upload_surface{EGL_NO_SURFACE};
+    SharedTextures shared;
+    // VCS_GLES_SHADER_WARMUP: config/shader-cache/ (empty: off) names every
+    // program variant earlier sessions linked, <key>.bin each; all are made
+    // before the first frame (`warming` set meanwhile). VCS_GLES_SHADER_CACHE:
+    // the files hold the driver's program binaries (GL_OES_get_program_binary,
+    // the two pointers set), loaded instead of compiling and saved after a
+    // compile; off or unsupported: the names still say what to compile.
+    std::string shader_cache_directory;
+    bool warming{};
+    PFNGLGETPROGRAMBINARYOESPROC get_program_binary{};
+    PFNGLPROGRAMBINARYOESPROC program_binary{};
+    std::uint64_t shader_source_hash{};
+    std::size_t cache_loaded{};
+    std::size_t cache_saved{};
+    FbdevWindow window{};
+    std::uint32_t screen_width{640u};
+    std::uint32_t screen_height{480u};
+    std::uint32_t target_width{kReferenceWidth};
+    std::uint32_t target_height{kReferenceHeight};
+    bool depth24{};
+    bool vsync{true};
+    std::unordered_map<std::uint64_t, GlTexture> textures;
+    std::unordered_map<std::uint32_t, Target> targets;
+    std::unordered_map<std::uint64_t, Program> programs;
+    Program present_program{};
+    std::uint32_t attribute_arrays{0xFFFFFFFFu};  // see set_attribute_arrays
+    GLuint guest_texture{};
+    std::uint32_t guest_width{};
+    std::uint32_t guest_height{};
+    // VCS_GLES_VBO: 1 (default) the frame's vertices go to the GPU in one
+    // upload, from a ring of buffers; 2 the indices too (slower on ARM's
+    // driver: it reads each draw's indices back from uncached memory); 0
+    // client-side arrays per draw.
+    bool use_vbo{true};
+    // VCS_GLES_STRIPS=0: unroll the PSP's triangle strips into lists. By
+    // default strips stay strips (about a third of the indices; ARM's driver
+    // copies and scans every index on the CPU).
+    bool strips{true};
+    // VCS_GLES_STRIP_RUNS=0: merged strips always go through an index array.
+    // By default consecutive strips drawn in stream order get the degenerate
+    // vertices joining them in the vertex stream (Batch::strip_join), so a
+    // merged group of them is one sequential run: glDrawArrays, no index
+    // copy in the driver.
+    bool strip_runs{true};
+    // VCS_GLES_CONST_ATTRIBS=0: set the constant attributes aQ and aFog per
+    // draw instead of once per frame.
+    bool const_attribs{true};
+    bool index_vbo{};
+    std::array<std::array<GLuint, 3>, 3> buffers{};  // [ring][vertices, packed, indices]
+    std::uint32_t ring{};
+    GLuint vertex_buffer{};
+    GLuint packed_buffer{};
+    std::uint32_t display_framebuffer{};
+    std::uint64_t frame_epoch{1u};
+    Target *current_target{};
+    GLuint current_program{};
+    // GL state as last set (see invalidate_state).
+    bool fixed_valid{};
+    std::uint32_t fixed_state{};
+    std::uint32_t blend_color{};
+    bool scissor_valid{};
+    std::array<GLint, 4> scissor{};
+    GLuint bound_texture{0xFFFFFFFFu};
+    // FPS counter: screen presents per second; drawn top left (Display.ShowFPS),
+    // logged with PSP and GL draws per frame (VCS_FPS_LOG).
+    double fps{};
+    bool log_fps{};
+    std::chrono::steady_clock::time_point fps_start{};
+    std::uint32_t fps_frames{};
+    std::uint64_t fps_psp_draws{};
+    std::uint64_t fps_gl_draws{};
+    // VCS_FPS_LOG: GL draws by glDrawArrays and by glDrawElements, and the
+    // index bytes the latter hand the driver, per frame.
+    std::uint64_t fps_gl_arrays{};
+    std::uint64_t fps_gl_elements{};
+    std::uint64_t fps_index_bytes{};
+    // VCS_FPS_LOG: bytes per frame sent to the GPU (vertices, packed, indices, textures).
+    std::array<std::uint64_t, 4> fps_bytes{};
+    // VCS_FPS_LOG: textures adopted from the upload thread and uploaded here,
+    // and programs compiled, per interval.
+    std::uint64_t fps_thread_uploads{};
+    std::uint64_t fps_render_uploads{};
+    std::uint64_t fps_compiles{};
+    std::uint64_t fps_culled{};
+    std::uint64_t fps_culled_vertices{};
+    // Why a batch could not join the previous GL draw (VCS_FPS_LOG=1): target,
+    // scissor, program, texture, sampler, fixed state, blend colour, uniforms,
+    // raw state, raw layout, strip/list, index range, first of frame.
+    std::array<std::uint64_t, 13> fps_breaks{};
+};
+
+// -------------------------------------------------------------- GE side --
+
+struct TextureInfo {
+    GeGpuDrawDescriptor descriptor{};
+    std::size_t bytes{};
+    std::uint64_t signature_epoch{};
+    std::uint64_t last_used_epoch{};
+};
+
+struct Gles2State {
+    std::recursive_mutex mutex;
+    GeGpuBackendReport report{};
+    bool enabled{};
+    std::vector<Vertex, DefaultInitAllocator<Vertex>> vertices;
+    std::vector<std::uint8_t> packed;
+    std::vector<std::uint32_t> indices;
+    std::vector<Batch> batches;
+    std::vector<GeGpuRawState> raw_states;
+    std::unordered_map<std::uint64_t, TextureInfo> textures;
+    std::size_t texture_bytes{};
+    std::vector<TextureUpload> uploads;
+    std::vector<std::uint64_t> deletes;
+    std::unordered_map<std::uint32_t, TargetSize> targets;
+    std::uint64_t culled_draws{};
+    std::uint64_t culled_vertices{};
+    std::vector<std::byte> last_texture_rgba;
+    std::uint32_t display_framebuffer{};
+    std::uint32_t display_logical_width{kReferenceWidth};
+    std::uint32_t display_logical_height{kReferenceHeight};
+    // The target last shown (see finish_color_frame): VCS draws its scene and
+    // HUD into a working buffer that is not the sceDisplaySetFrameBuf address.
+    std::uint32_t last_winner{};
+    std::uint64_t last_winner_geometry{};
+    std::uint32_t small_frames{};  // vblanks in a row whose largest target was small
+    struct FrameExtent { std::uint32_t width, height, stride; };
+    std::unordered_map<std::uint32_t, FrameExtent> frame_extents;  // see note_target()
+    std::uint64_t frame_epoch{1u};
+    // Vblanks since the GE last produced a displayed frame (see
+    // ge_gpu_backend_presents_directly).
+    std::uint32_t vblanks_since_gpu_frame{~0u};
+
+    // The frame queues and threads: GE thread -> transform worker -> render
+    // thread (one frame waiting at each step).
+    std::mutex queue_mutex;
+    std::condition_variable queue_cv;
+    std::unique_ptr<Frame> to_transform;
+    std::unique_ptr<Frame> queued;
+    std::vector<std::unique_ptr<Frame>> spare;
+    bool stop{};
+    bool use_transform_thread{};
+    bool use_upload_thread{};
+    std::thread transform_thread;
+    std::thread upload_thread;
+    std::thread render_thread;
+    RenderState render;
+
+    ~Gles2State() { stop_render_thread(); }
+    void stop_render_thread();
+};
