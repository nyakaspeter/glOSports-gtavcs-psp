+// A hardware-transform draw whose vertices go to the GPU as the PSP stores
+// them (any layout with one morph frame): the vertex shader decodes, skins
+// and lights them. Element types and offsets as the PSP's vertex type word.
+// (ga36-lcs-recomp-port 0025.)
+struct GeGpuRawLayout {
+    std::uint32_t stride{};
+    std::uint8_t position_type{};
+    std::uint8_t normal_type{};
+    std::uint8_t tc_type{};
+    std::uint8_t color_type{};
+    std::uint8_t weight_type{};
+    std::uint8_t weight_count{};
+    std::uint8_t position_offset{};
+    std::uint8_t normal_offset{};
+    std::uint8_t tc_offset{};
+    std::uint8_t color_offset{};
+    std::uint8_t weight_offset{};
+    bool lit{};
+    std::uint8_t uv_generation{};
+    // The lighting the shader variant is built for: the enabled lights,
+    // compacted into uR slots 0..lights-1, and which features any of them use
+    // (the Mali-400 vertex shader holds 512 instruction words; the general
+    // light model with 8-bone skinning did not fit).
+    std::uint8_t lights{};
+    bool light_point{};
+    bool light_spot{};
+    bool light_specular{};
+    bool light_pow{};
+    bool operator==(const GeGpuRawLayout &) const = default;
+};
+
+// The raw path's per-draw state beyond the transform, as the vertex shader's
+// uniform array uR: 0-2 world matrix rows, 3-5 texture matrix rows,
+// 6 material ambient (rgba), 7 diffuse, 8 specular, 9 emissive, 10 global
+// ambient (rgba), 11 (specular exponent, material update bits, normal sign,
+// lighting on), 12 the constant vertex colour (layouts without one), 13 uv
+// generation (mode, light s, light t, source), 14-37 four lights of six
+// (position or direction + type; attenuation + computation; spot direction +
+// cutoff; ambient + spot exponent; diffuse + enabled; specular), 38-61 eight
+// bone matrices of three rows, 62-63 the environment map's two light
+// directions.
+constexpr std::size_t kGeGpuRawUniforms = 64u;
+constexpr std::size_t kGeGpuRawLightBase = 14u;
+constexpr std::size_t kGeGpuRawBoneBase = 38u;
+struct GeGpuRawState {
+    std::array<std::array<float, 4>, kGeGpuRawUniforms> uniforms{};
+};
+
+// A hardware-transform draw of raw vertices (see GeGpuRawLayout). state_changed:
+// the state differs from the previous raw draw's (the backend keeps one copy
+// per change). False: not taken; the caller decodes on the CPU instead.
+[[nodiscard]] bool ge_gpu_backend_accumulate_hardware_raw(
+    const GeGpuDrawDescriptor &draw,
+    const GeGpuHardwareTransform &transform,
+    const GeGpuRawLayout &layout,
+    std::span<const std::byte> raw_vertices,
+    std::uint32_t vertex_count,
+    std::span<const std::uint32_t> triangle_indices,
+    const GeGpuRawState &state,
+    bool state_changed) noexcept;
