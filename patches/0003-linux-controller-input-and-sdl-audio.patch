+// Linux handheld input and presentation for the GLES 2 GE backend (ARM's
+// Mali-400 fbdev driver on the GA36-MB). There is no window: the backend
+// owns the screen through EGL on /dev/fb0, and frames the GE did not draw
+// (movies, screens the game writes to guest RAM) go to it as RGBA. SDL is
+// used for the game controller only.
+#include "display_window.hpp"
+#include "ge_gpu_backend.hpp"
+#include "vcs_camera_input.hpp"
+#include "vcs_config.hpp"
+#include "vcs_key_prompts.hpp"
+#include "vcs_vehicle_input.hpp"
+
+#include <SDL.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+#include <iostream>
+#include <mutex>
+#include <vector>
