     ++r.fps_frames;
+    if (r.shown_start.time_since_epoch().count() == 0) r.shown_start = now;
+    else ++r.shown_frames;
+    if (now - r.shown_start >= std::chrono::seconds(1)) {
+        r.shown_fps = r.shown_frames / std::chrono::duration<double>(now - r.shown_start).count();
+        r.shown_frames = 0u;
+        r.shown_start = now;
+    }
     r.fps_psp_draws += psp_draws;
