+                    reason = "continuation not a unit entry of the function"; break;
+                }
+                continuations.push_back(continuation);
+            }
+            if (d.kind == K::Syscall || (delay && slot.kind == K::Syscall)) { reason = "syscall"; break; }
+            if (d.kind == K::Unsupported || d.kind == K::Vfpu || (delay && (slot.kind == K::Unsupported || slot.kind == K::Vfpu))) {
