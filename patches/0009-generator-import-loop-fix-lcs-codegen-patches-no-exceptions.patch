+std::set<std::uint32_t> load_pc_list(const std::filesystem::path &path) {
+    std::ifstream in(path);
+    if (!in) throw psprecomp::Error("Cannot open PC list: " + path.string());
+    std::set<std::uint32_t> pcs;
+    std::string line;
+    while (std::getline(in, line)) {
+        const auto end = line.find_first_of(" \t#\r");
+        if (end != std::string::npos) line.erase(end);
+        if (line.empty()) continue;
+        pcs.insert(parse_hex(line));
+    }
+    return pcs;
+}
