+RegionSelection select_function_regions(const psprecomp::ProgramAnalysis &program,
+                                        const psprecomp::GuestMemory &memory,
+                                        const std::set<std::uint32_t> &import_stubs,
+                                        const std::set<std::uint32_t> &excluded_pcs,
+                                        const std::set<std::uint32_t> &global_entries,
+                                        const std::set<std::uint32_t> &valid_units,
+                                        std::uint32_t executable_base,
+                                        std::uint32_t unit_span_bytes,
+                                        bool allow_calls) {
+    using K = psprecomp::OpcodeKind;
+    RegionSelection selection;
+    const auto &ranges = program.executable_ranges;
+    const auto jump_target = [](std::uint32_t pc, const psprecomp::DecodedInstruction &d) {
+        return ((pc + 4u) & 0xF0000000u) | (d.target << 2u);
+    };
+    const auto branch_target = [](std::uint32_t pc, const psprecomp::DecodedInstruction &d) {
+        return pc + 4u + static_cast<std::uint32_t>(static_cast<std::int32_t>(d.immediate) * 4);
+    };
+
+    // Instructions owned by more than one analysed function, direct call
+    // counts per target, and every j/branch edge in the program by target.
+    std::unordered_map<std::uint32_t, std::uint32_t> owner_count;
+    owner_count.reserve(program.covered_labels.size() * 2u);
+    for (const auto &function : program.functions)
+        for (const auto label : function.labels) ++owner_count[label];
+    std::unordered_map<std::uint32_t, std::size_t> jal_sites_by_target;
+    std::unordered_map<std::uint32_t, std::vector<std::uint32_t>> jump_sources_by_target;
+    for (const auto pc : program.covered_labels) {
+        const auto d = psprecomp::decode_allegrex(memory.load32(pc));
+        if (d.kind == K::Jal) ++jal_sites_by_target[jump_target(pc, d)];
+        else if (d.kind == K::J) jump_sources_by_target[jump_target(pc, d)].push_back(pc);
+        else if (is_branch(d.kind)) jump_sources_by_target[branch_target(pc, d)].push_back(pc);
+    }
+
+    for (const auto &function : program.functions) {
+        if (function.labels.empty()) continue;
+        ++selection.candidates;
+        const auto exclude = [&](const char *reason) { ++selection.excluded[reason]; };
+        if (function.truncated) { exclude("truncated"); continue; }
+        if (jal_sites_by_target[function.entry] == 0u) { exclude("not a jal target"); continue; }
+        if (!global_entries.contains(function.entry)) { exclude("entry not a unit entry"); continue; }
+        bool shared = false;
+        for (const auto label : function.labels) if (owner_count[label] > 1u) { shared = true; break; }
+        if (shared) { exclude("shares instructions with another function"); continue; }
+        const std::uint32_t first = *function.labels.begin();
+        const std::uint32_t last = *function.labels.rbegin();
+        const std::uint32_t unit = (function.entry - executable_base) / unit_span_bytes;
+        if (first < executable_base || (first - executable_base) / unit_span_bytes != unit ||
+            (last + 4u - executable_base) / unit_span_bytes != unit) { exclude("straddles a unit boundary"); continue; }
+        if (!valid_units.contains(unit)) { exclude("unit not emitted"); continue; }
+        bool has_import = false, has_excluded = false;
+        for (const auto label : function.labels) {
+            if (import_stubs.contains(label) || import_stubs.contains(label + 4u)) has_import = true;
+            if (excluded_pcs.contains(label) || excluded_pcs.contains(label + 4u)) has_excluded = true;
+        }
+        if (has_import) { exclude("contains an import stub"); continue; }
+        if (has_excluded) { exclude("contains a hooked PC"); continue; }
+
+        const char *reason = nullptr;
+        std::vector<std::uint32_t> continuations;
+        for (const auto pc : function.labels) {
+            const auto d = psprecomp::decode_allegrex(memory.load32(pc));
+            psprecomp::DecodedInstruction slot{};
+            const bool delay = d.has_delay_slot();
+            if (delay) slot = psprecomp::decode_allegrex(memory.load32(pc + 4u));
+            if (d.kind == K::Jal || d.kind == K::Jalr || is_link_branch(d.kind)) {
