+// --leaf-functions / --call-functions: a guest function is a region when it
+// can be emitted as one host function entered only at its entry (and, for a
+// call function, at the continuation after each of its calls) and left only
+// by `jr $ra`, a call's unwind or an import's handoff: its instructions belong
+// to no other analysed function, it writes $ra only through lw (a frame
+// restore) or its own jal/jalr, has no syscall and no computed jr, no
+// j/branch leaves it and none (and no jal) enters it from outside except a
+// jal to its entry, it does not straddle a unit boundary, and it contains no
+// import stub and no excluded (hand-hooked) PC.  A leaf makes no call of any
+// kind; a call function (allow_calls) makes jal/jalr calls, none to a label
+// of its own body except its entry, every continuation (call PC + 8) is one
+// of its own blocks and a unit entry, and it has no link branch (bal & co.,
+// whose returns would land on non-continuation labels).  Only jal targets
+// are converted: a region nobody calls directly gains nothing.  Everything
+// doubtful is excluded.
+struct FunctionRegion {
+    std::uint32_t entry{};
+    std::uint32_t unit{};
+    std::set<std::uint32_t> instructions;   // the function's labels
+    std::set<std::uint32_t> entry_labels;   // its blocks, as the unit had them
+    bool calls{};                           // a call function, not a leaf
+    std::vector<std::uint32_t> continuations;  // call PC + 8, ascending
+};
+
+struct RegionSelection {
+    std::vector<FunctionRegion> regions;
+    std::map<std::string, std::size_t> excluded;  // reason -> count
+    std::size_t candidates{};
+    std::size_t jal_sites{};                       // jal sites that now call a leaf
+    std::size_t call_jal_sites{};                  // jal sites that now call a call function
+};
+
+bool writes_ra_oddly(const psprecomp::DecodedInstruction &d) {
+    using K = psprecomp::OpcodeKind;
+    switch (d.kind) {
+    case K::Lw: case K::Jal: case K::Jalr: case K::Bltzal: case K::Bgezal: case K::Bltzall: case K::Bgezall:
+        return false;
+    case K::Addiu: case K::Lui: case K::Ori: case K::Andi: case K::Xori: case K::Slti: case K::Sltiu:
+    case K::Lh: case K::Lhu: case K::Lb: case K::Lbu: case K::Lwl: case K::Lwr: case K::Mfc1: case K::Mfv:
+    case K::Cfc1: case K::Ext: case K::Ins:
+        return d.rt == 31u;
+    case K::Add: case K::Addu: case K::Sub: case K::Subu: case K::Or: case K::And: case K::Xor: case K::Nor:
+    case K::Sll: case K::Srl: case K::Sra: case K::Rotr: case K::Sllv: case K::Srlv: case K::Srav: case K::Rotrv:
+    case K::Slt: case K::Sltu: case K::Movz: case K::Movn: case K::Mfhi: case K::Mflo: case K::Max: case K::Min:
+    case K::Seb: case K::Seh: case K::Clz: case K::Clo: case K::Bitrev: case K::Wsbh: case K::Wsbw:
+        return d.rd == 31u;
+    default:
+        return false;
+    }
+}
