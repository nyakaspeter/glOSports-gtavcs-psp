+            }
+            if (delay && slot.is_control_flow()) { reason = "control flow in delay slot"; break; }
+            if (d.kind == K::Jr && d.rs != 31u) { reason = "computed jr"; break; }
+            if (writes_ra_oddly(d) || (delay && writes_ra_oddly(slot))) { reason = "writes $ra"; break; }
+            if (d.kind == K::J) {
+                if (!function.labels.contains(jump_target(pc, d))) { reason = "j leaves the function"; break; }
+            } else if (is_branch(d.kind)) {
+                const std::uint32_t taken = branch_target(pc, d);
+                const std::uint32_t fallthrough = pc + 8u;
+                if ((psprecomp::is_executable_address(ranges, taken) && !function.labels.contains(taken)) ||
+                    (psprecomp::is_executable_address(ranges, fallthrough) && !function.labels.contains(fallthrough))) {
+                    reason = "branch leaves the function"; break;
+                }
+            } else if (!delay && !d.is_control_flow()) {
+                // Linear flow must stay inside the function (a seed right after
+                // a non-returning path would otherwise be fallen into).
+                const std::uint32_t next = pc + 4u;
+                if (psprecomp::is_executable_address(ranges, next) && !function.labels.contains(next)) {
+                    reason = "falls out of the function"; break;
+                }
+            }
+            if (!delay && d.is_control_flow()) { reason = "unexpected control flow"; break; }
+        }
+        if (reason != nullptr) { exclude(reason); continue; }
+        bool entered_from_outside = false;
+        for (const auto label : function.labels) {
+            const auto sources = jump_sources_by_target.find(label);
+            if (sources == jump_sources_by_target.end()) continue;
+            for (const auto source : sources->second)
+                if (!function.labels.contains(source)) { entered_from_outside = true; break; }
+            if (entered_from_outside) break;
+        }
+        if (entered_from_outside) { exclude("j/branch target from outside"); continue; }
+        if (allow_calls) {
+            // A jal anywhere to a label of the body other than the entry.
+            bool jal_into_body = false;
+            for (const auto label : function.labels)
+                if (label != function.entry && jal_sites_by_target.contains(label) &&
+                    jal_sites_by_target.at(label) != 0u) { jal_into_body = true; break; }
+            if (jal_into_body) { exclude("jal target inside the body"); continue; }
+        }
+
+        FunctionRegion region;
+        region.entry = function.entry;
+        region.unit = unit;
+        region.instructions = function.labels;
+        for (const auto label : function.labels)
+            if (global_entries.contains(label)) region.entry_labels.insert(label);
+        // VCS: the dispatcher also re-enters functions at inner blocks it has
+        // registered (upstream registers every block entry), e.g. after a
+        // thread switch in an HLE. Each one becomes a continuation, so the
+        // function's entry switch resumes there; only functions with no inner
+        // entry stay leaves.
+        if (allow_calls) {
+            for (const auto label : region.entry_labels)
+                if (label != function.entry) continuations.push_back(label);
+            std::sort(continuations.begin(), continuations.end());
+            continuations.erase(std::unique(continuations.begin(), continuations.end()), continuations.end());
+        } else if (region.entry_labels.size() > 1u) {
+            exclude("inner entries");
+            continue;
+        }
+        region.calls = !continuations.empty();
+        region.continuations = std::move(continuations);
+        (region.calls ? selection.call_jal_sites : selection.jal_sites) += jal_sites_by_target[function.entry];
+        selection.regions.push_back(std::move(region));
+    }
+    return selection;
+}
