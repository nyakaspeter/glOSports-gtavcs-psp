 // scene. The correction is heavily damped (12.5% of measured drift per
 // second) and clamped (max 6ms/s) specifically so it cannot outrun normal
 // sleep/catch-up pacing and cannot itself become a source of stutter.
+// VCS_FPS_CAP=<n>: at most n game frames a second. A game frame is a vblank
+// wait after which the game's frame counter (gp-8852, the one the unlocked
+// limiter reads) has moved; movies and loading screens, which wait every
+// vblank without it moving, are not held back (the old cap waited 1/30 s at
+// every vblank wait and ran movies at half speed). A frame that ran late
+// starts the 1/n s grid again, so the rate never goes over the cap. Runs
+// before limit_frame_rate(), which then moves the guest
+// clock past the time waited, as for any slow frame.
+void cap_game_frames(psprecomp::Runtime &rt, const psprecomp::AllegrexContext &ctx) {
+    static const std::uint32_t fps = [] {
+        const char *text = VCS_ENV("VCS_FPS_CAP");
+        if (text == nullptr || *text == '\0') return 0u;
+        return static_cast<std::uint32_t>(std::strtoul(text, nullptr, 10));
+    }();
+    if (fps == 0u) return;
+    static std::uint32_t last_counter = 0u;
+    static std::chrono::steady_clock::time_point deadline{};
+    const std::uint32_t address = ctx.gpr[28] + static_cast<std::uint32_t>(kGuestFrameCounterGpOffset);
+    if (!rt.memory().contains(address, 4u)) return;
+    const std::uint32_t counter = rt.memory().load32(address);
+    if (counter == last_counter) return;
+    last_counter = counter;
+    const auto period = std::chrono::microseconds(1000000u / fps);
+    const auto now = std::chrono::steady_clock::now();
+    // A frame that ran late starts the grid again from now: no quick frames
+    // after it to win the time back, so the rate never goes over the cap.
+    if (deadline.time_since_epoch().count() == 0) deadline = now;
+    deadline += period;
+    if (deadline <= now) {
+        deadline = now;
+        return;
+    }
+    constexpr auto spin_margin = std::chrono::microseconds(1500);
+    if (deadline - now > spin_margin) std::this_thread::sleep_until(deadline - spin_margin);
+    while (std::chrono::steady_clock::now() < deadline) std::this_thread::yield();
+}
