+// --cache-gpr: the hand-made LZ copy loop (0x08B64AD8) writes registers and
+// jumps to labels in its own text, which the register dataflow does not see;
+// the function that holds it keeps its registers in the context.
+// So do the functions that upstream's hand-made hooks edit after generation
+// (the 4:3 projection, camera and aim, the pool-allocator assertion, the
+// audio and movie hooks): their text names ctx.gpr, and the hooks are applied
+// to the generated units as a patch.
+bool has_hand_made_blocks(const GeneratedFunctionInput &function, const psprecomp::GuestMemory &) {
+    static const std::set<std::uint32_t> hooked{
+        0x08934A24u, 0x08934B9Cu, 0x08937A28u, 0x08975D4Cu, 0x08985A1Cu, 0x0898D140u,
+        0x0898D2D8u, 0x0898DE2Cu, 0x0898DF58u, 0x0898E080u, 0x0898E188u, 0x0899DFE4u,
+        0x08B61028u, 0x08B6159Cu, 0x08B6B650u, 0x0893671Cu};
+    return function.instructions.contains(0x08B64AD8u) || hooked.contains(function.address);
