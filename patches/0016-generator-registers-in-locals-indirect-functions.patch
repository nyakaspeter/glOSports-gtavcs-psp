+// --cache-gpr: inside a leaf or call function every guest register the
+// function names lives in a local `std::uint32_t r<n>` instead of
+// ctx.gpr[n].  Guest stores go through the window's uint8_t pointer, which
+// may alias AllegrexContext, so GCC reloads ctx.gpr[] after every one of
+// them; it cannot do that to a local whose address never escapes.  Two
+// forward dataflows over the function's blocks place the context traffic:
+//   load  `r<n> = ctx.gpr[n]` where r<n> is read and not valid yet (valid:
+//         loaded or written on every path since the function was entered,
+//         a continuation resumed or a chained call returned), and on a goto
+//         whose target expects more valid registers than the edge has;
+//   store `ctx.gpr[n] = r<n>` of every register written since then (dirty)
+//         before each chained call, each return and each host call that
+//         reads the context: rt.unsupported, rt.arithmetic_overflow, and
+//         ctx.execute_signed_add/_sub, which read and write ctx.gpr by index
+//         themselves (their destination is reloaded after them).
+// A goto stores what is dirty on its edge but not at its target and loads
+// what its target expects valid and the edge lacks, so any choice of the
+// blocks' incoming sets is correct; they are chosen for speed (see
+// finalize_gpr_cache): mostly intersections, so no value is kept alive just
+// to be stored or used on another path, and at loop headers what every back
+// edge has, so a loop keeps its values in locals across iterations.
+// An unwound call returns without storing: the context is then the only
+// copy of the guest state.  Dirty is a subset of valid everywhere, so a load
+// never overwrites a pending value and a store never writes an unloaded
+// local.  $zero stays the literal 0u; ctx.pc and jump_target are unchanged.
+std::string lower_constant_gpr_writes(std::string text);
+
+std::uint32_t gpr_read_mask(const std::string &text) {
+    constexpr std::string_view needle = "ctx.gpr[";
+    std::uint32_t mask = 0u;
+    for (std::size_t at = text.find(needle); at != std::string::npos; at = text.find(needle, at + 1u)) {
+        const std::size_t begin = at + needle.size();
+        std::size_t cursor = begin;
+        while (cursor < text.size() && std::isdigit(static_cast<unsigned char>(text[cursor]))) ++cursor;
+        if (cursor == begin || cursor >= text.size() || text[cursor] != ']')
+            throw psprecomp::Error("--cache-gpr: non-constant gpr index in " + text);
+        const auto index = static_cast<std::uint32_t>(std::stoul(text.substr(begin, cursor - begin)));
+        if (index == 0u || index >= 32u) throw psprecomp::Error("--cache-gpr: gpr index in " + text);
+        mask |= 1u << index;
+    }
+    return mask;
+}
+
+std::uint32_t gpr_write_mask(const std::string &text) {
+    constexpr std::string_view needle = "ctx.set_gpr(";
+    std::uint32_t mask = 0u;
+    for (std::size_t at = text.find(needle); at != std::string::npos; at = text.find(needle, at + 1u)) {
+        const std::size_t begin = at + needle.size();
+        std::size_t cursor = begin;
+        while (cursor < text.size() && std::isdigit(static_cast<unsigned char>(text[cursor]))) ++cursor;
+        if (cursor == begin) throw psprecomp::Error("--cache-gpr: non-constant set_gpr in " + text);
+        const auto index = static_cast<std::uint32_t>(std::stoul(text.substr(begin, cursor - begin)));
+        if (index >= 32u) throw psprecomp::Error("--cache-gpr: set_gpr index in " + text);
+        if (index != 0u) mask |= 1u << index;
+    }
+    return mask;
+}
+
+struct GprCache {
+    // A point in a block: its sets are the block's incoming sets plus these.
+    struct Point { std::uint32_t block; std::uint32_t dirty; std::uint32_t valid; std::uint32_t mask; };
+    // An edge into block `to`; from_block false: function entry, a
+    // continuation or a call's return (nothing dirty, nothing valid).  For
+    // the dominators a call's return comes from the calling block (`from`),
+    // the function entry from the root, and an entry-id case not at all;
+    // Call (dominators only): a call through the dispatcher (an import) to
+    // its continuation, which is entered by a case.
+    enum class Kind : std::uint8_t { Block, Entry, Case, Return, Call };
+    struct Edge { std::uint32_t from; std::uint32_t to; bool from_block; std::uint32_t dirty; std::uint32_t valid; Kind kind; };
+    struct State { std::uint32_t dirty; std::uint32_t valid; };
+    std::vector<Point> loads;    // mask: registers read here
+    std::vector<Point> stores;
+    std::vector<Edge> edges;
+    std::vector<std::uint32_t> reloads;  // a single register reloaded (after add/sub)
+    std::uint32_t block{};
+    std::uint32_t dirty{};
+    std::uint32_t valid{};
+    std::uint32_t noted{};       // every register noted as written
+
+    void begin_block(std::uint32_t label) { block = label; dirty = 0u; valid = 0u; }
+    [[nodiscard]] State save() const { return {dirty, valid}; }
+    void restore(State state) { dirty = state.dirty; valid = state.valid; }
+    void write(std::uint32_t mask) { dirty |= mask; valid |= mask; noted |= mask; }
+    // Loads of the registers `mask` that are not valid here.
+    std::string read(std::uint32_t mask) {
+        if (mask == 0u) return {};
+        loads.push_back({block, dirty, valid, mask});
+        valid |= mask;
+        return "@@GL_" + std::to_string(loads.size() - 1u) + "@@";
+    }
+    std::string read_line(std::uint32_t mask) {
+        std::string token = read(mask);
+        return token.empty() ? token : "    " + token + "\n";
+    }
+    // Stores of the dirty registers (the state is unchanged: a store sits on
+    // one path, before a call or a return).
+    std::string store(const std::string &indent) {
+        stores.push_back({block, dirty, valid, 0u});
+        return indent + "@@GS_" + std::to_string(stores.size() - 1u) + "@@\n";
+    }
+    // Inline, in front of a `goto L_<to>`.
+    std::string edge(std::uint32_t to) {
+        edges.push_back({block, to, true, dirty, valid, Kind::Block});
+        return "@@GE_" + std::to_string(edges.size() - 1u) + "@@";
+    }
+    std::string entry_edge(std::uint32_t to, Kind kind = Kind::Entry) {
+        edges.push_back({block, to, false, 0u, 0u, kind});
+        return "@@GE_" + std::to_string(edges.size() - 1u) + "@@";
+    }
+    // After a chained call that came back to its continuation `to`.
+    std::string resume(std::uint32_t to) {
+        return "{ " + entry_edge(to, Kind::Return) + "goto L_" + psprecomp::hex32(to).substr(2) + "; }";
+    }
+    void call_edge(std::uint32_t to) { edges.push_back({block, to, false, 0u, 0u, Kind::Call}); }
+    // An entry-id case of a call function (resumption after an unwind).
+    std::string entry_case(std::uint32_t to) {
+        return "{ " + entry_edge(to, Kind::Case) + "goto L_" + psprecomp::hex32(to).substr(2) + "; }";
+    }
+    // One emitted guest instruction.
+    std::string instruction(std::string text) {
+        const std::uint32_t reads = gpr_read_mask(text);
+        const std::uint32_t writes = gpr_write_mask(text);
+        if (text.find("ctx.execute_signed_") != std::string::npos) {
+            // add/sub: reads and writes ctx.gpr by index; store before, reload rd after.
+            static const std::regex form(R"(ctx\.execute_signed_(?:add|sub)\(([0-9]+)u, [0-9]+u, [0-9]+u\))");
+            std::smatch match;
+            if (reads != 0u || writes != 0u || !std::regex_search(text, match, form))
+                throw psprecomp::Error("--cache-gpr: unexpected add/sub form " + text);
+            const auto destination = static_cast<std::uint32_t>(std::stoul(match[1].str()));
+            std::string out = store("    ") + text;
+            if (destination != 0u && destination < 32u) {
+                reloads.push_back(destination);
+                out += "    @@GR_" + std::to_string(reloads.size() - 1u) + "@@\n";
+                valid |= 1u << destination;
+            }
+            return out;
+        }
+        if (text.find("return;") != std::string::npos) {
+            // rt.unsupported(...); return; -- the context must be current.
+            if (reads != 0u || writes != 0u)
+                throw psprecomp::Error("--cache-gpr: register access before a return in " + text);
+            return store("    ") + text;
+        }
+        // A conditional write (movz/movn) keeps the old value on the other
+        // path, so its destination must be valid before it.
+        const bool conditional = text.find("if (") != std::string::npos;
+        std::string out = read_line(reads | (conditional ? writes : 0u)) + text;
+        write(writes);
+        return out;
+    }
+};
+
+// Resolves the loads and stores, renames ctx.gpr[n] to r<n>, declares the
+// locals.
+std::string finalize_gpr_cache(std::string text, const GprCache &cache, const std::string &name) {
+    text = lower_constant_gpr_writes(std::move(text));
+    if (text.find("ctx.set_gpr(") != std::string::npos)
+        throw psprecomp::Error("--cache-gpr: set_gpr left in " + name);
+    static const std::regex reference(R"(ctx\.gpr\[([0-9]+)\])");
+    static const std::regex assignment(R"(ctx\.gpr\[([0-9]+)\] = )");
+    const std::uint32_t used = gpr_read_mask(text);
+    std::uint32_t written = 0u;
+    for (std::sregex_iterator it(text.begin(), text.end(), assignment), end; it != end; ++it)
+        written |= 1u << static_cast<std::uint32_t>(std::stoul((*it)[1].str()));
+    if ((written & ~cache.noted) != 0u)
+        throw psprecomp::Error("--cache-gpr: register write the dataflow did not see in " + name);
+    text = std::regex_replace(text, reference, "r$1");
+    if (text.find("gpr") != std::string::npos)
+        throw psprecomp::Error("--cache-gpr: other context register access in " + name);
+
+    // Back edges: edges whose target dominates their source (dominators over
+    // the blocks of the ordinary flow: from a virtual root to the function
+    // entry, gotos, and calls to their continuations).
+    std::vector<std::uint32_t> blocks;
+    for (const auto &edge : cache.edges) {
+        blocks.push_back(edge.to);
+        if (edge.kind != GprCache::Kind::Entry && edge.kind != GprCache::Kind::Case)
+            blocks.push_back(edge.from);
+    }
+    std::sort(blocks.begin(), blocks.end());
+    blocks.erase(std::unique(blocks.begin(), blocks.end()), blocks.end());
+    const std::size_t count = blocks.size() + 1u;  // [0] is the root
+    const auto node = [&](std::uint32_t block) {
+        return static_cast<std::size_t>(std::lower_bound(blocks.begin(), blocks.end(), block) - blocks.begin()) + 1u;
+    };
+    std::vector<std::vector<std::size_t>> predecessors(count);
+    for (const auto &edge : cache.edges) {
+        if (edge.kind == GprCache::Kind::Case) continue;
+        predecessors[node(edge.to)].push_back(edge.kind == GprCache::Kind::Entry ? 0u : node(edge.from));
+    }
+    const std::size_t words = (count + 63u) / 64u;
+    std::vector<std::vector<std::uint64_t>> dominators(count, std::vector<std::uint64_t>(words, ~0ull));
+    dominators[0].assign(words, 0ull);
+    dominators[0][0] = 1ull;
+    for (bool changed = true; changed;) {
+        changed = false;
+        for (std::size_t n = 1u; n < count; ++n) {
+            std::vector<std::uint64_t> value(words, predecessors[n].empty() ? 0ull : ~0ull);
+            for (const auto p : predecessors[n])
+                for (std::size_t w = 0u; w < words; ++w) value[w] &= dominators[p][w];
+            value[n / 64u] |= 1ull << (n % 64u);
+            if (value != dominators[n]) { dominators[n] = std::move(value); changed = true; }
+        }
+    }
+    const auto back_edge = [&](const GprCache::Edge &edge) {
+        if (!edge.from_block) return false;
+        const std::size_t to = node(edge.to);
+        return ((dominators[node(edge.from)][to / 64u] >> (to % 64u)) & 1ull) != 0ull;
+    };
+
+    // dirty_in: what is dirty on every incoming edge, plus, at a loop
+    // header, what is dirty on every back edge (written in every iteration:
+    // stored once after the loop, not in each iteration); the least solution
+    // (a value dirty before a loop and untouched in it is stored on the
+    // entry edge).  valid_in: what is valid on every incoming edge, plus
+    // dirty_in, plus at a loop header what every back edge has when the
+    // header has only that (loaded or written in every iteration: loaded on
+    // the entry edges once instead of in each iteration); the greatest
+    // solution (a value valid before a loop and untouched in it stays valid
+    // in it), the headers' additions fixed between the two passes.
+    std::map<std::uint32_t, std::uint32_t> dirty_in, valid_in, hoisted;
+    const auto in = [](const std::map<std::uint32_t, std::uint32_t> &sets, std::uint32_t block) {
+        const auto found = sets.find(block);
+        return found != sets.end() ? found->second : 0u;
+    };
+    // Returns, per block, the intersection over its back edges (all ones:
+    // none).
+    const auto solve = [&](std::map<std::uint32_t, std::uint32_t> &sets, std::uint32_t start, bool valid) {
+        for (const auto &edge : cache.edges)
+            if (edge.kind != GprCache::Kind::Call) sets[edge.to] = start;
+        std::map<std::uint32_t, std::pair<std::uint32_t, std::uint32_t>> meet;  // all, back edges
+        for (bool changed = true; changed;) {
+            changed = false;
+            meet.clear();
+            for (const auto &edge : cache.edges) {
+                if (edge.kind == GprCache::Kind::Call) continue;
+                const std::uint32_t value = (edge.from_block ? in(sets, edge.from) : 0u) |
+                                            (valid ? edge.valid : edge.dirty);
+                auto [found, first] = meet.try_emplace(edge.to, value, 0xFFFFFFFFu);
+                if (!first) found->second.first &= value;
+                if (back_edge(edge)) found->second.second &= value;
+            }
+            for (auto &[block, set] : sets) {
+                const auto &[all, back] = meet[block];
+                std::uint32_t value = all;
+                if (valid) value |= in(dirty_in, block) | in(hoisted, block);
+                else if (back != 0xFFFFFFFFu) value |= back;
+                value &= used;
+                if (value != set) { set = value; changed = true; }
+            }
+        }
+        std::map<std::uint32_t, std::uint32_t> back_meet;
+        for (const auto &[block, sets_of_block] : meet)
+            if (sets_of_block.second != 0xFFFFFFFFu) back_meet[block] = sets_of_block.second;
+        return back_meet;
+    };
+    solve(dirty_in, 0u, false);
+    hoisted = solve(valid_in, used, true);
+    solve(valid_in, used, true);
+    const auto list = [](std::uint32_t mask, const char *format) {
+        std::string out;
+        for (std::uint32_t index = 1u; index < 32u; ++index) {
+            if ((mask & (1u << index)) == 0u) continue;
+            std::string item = format;
+            for (std::size_t at; (at = item.find('#')) != std::string::npos;)
+                item.replace(at, 1u, std::to_string(index));
+            out += item;
+        }
+        return out;
+    };
+    const auto load_list = [&](std::uint32_t mask) { return list(mask, "r# = ctx.gpr[#]; "); };
+
+    std::string out;
+    out.reserve(text.size() + 1024u);
+    std::size_t written_to = 0u;
+    for (std::size_t at = text.find("@@G"); at != std::string::npos; at = text.find("@@G", written_to)) {
+        const std::size_t close = text.find("@@", at + 3u);
+        const std::string token = text.substr(at + 2u, close - at - 2u);  // e.g. "GL_12" or "GD"
+        std::string replacement;
+        if (token == "GD") {
+            if (used != 0u) {
+                const std::string names = list(used, "r#, ");
+                replacement = "std::uint32_t " + names.substr(0, names.size() - 2u) + ";";
+            }
+        } else {
+            const auto index = static_cast<std::size_t>(std::stoul(token.substr(3)));
+            if (token.starts_with("GL_")) {
+                const auto &point = cache.loads.at(index);
+                replacement = load_list(point.mask & ~(in(valid_in, point.block) | point.valid));
+            } else if (token.starts_with("GS_")) {
+                const auto &point = cache.stores.at(index);
+                replacement = list((in(dirty_in, point.block) | point.dirty) & used, "ctx.gpr[#] = r#; ");
+            } else if (token.starts_with("GE_")) {
+                const auto &edge = cache.edges.at(index);
+                const std::uint32_t dirty = (edge.from_block ? in(dirty_in, edge.from) : 0u) | edge.dirty;
+                const std::uint32_t have = (edge.from_block ? in(valid_in, edge.from) : 0u) | edge.valid;
+                replacement = list(dirty & ~in(dirty_in, edge.to) & used, "ctx.gpr[#] = r#; ") +
+                              load_list(in(valid_in, edge.to) & ~have & used);
+            } else if (token.starts_with("GR_")) {
+                replacement = load_list(1u << cache.reloads.at(index));
+            } else {
+                throw psprecomp::Error("--cache-gpr: bad token in " + name);
+            }
+        }
+        // A token alone on its line takes the line with it when it is empty.
+        const std::size_t line_start = text.rfind('\n', at) + 1u;
+        const bool alone = text.find_first_not_of(' ', line_start) == at &&
+                           close + 2u < text.size() && text[close + 2u] == '\n';
+        if (alone) {
+            out.append(text, written_to, line_start - written_to);
+            if (!replacement.empty()) {
+                while (replacement.back() == ' ') replacement.pop_back();
+                out.append(text, line_start, at - line_start);
+                out += replacement + "\n";
+            }
+            written_to = close + 3u;
+        } else {
+            out.append(text, written_to, at - written_to);
+            out += replacement;
+            written_to = close + 2u;
+        }
+    }
+    out.append(text, written_to, std::string::npos);
+    return out;
+}
