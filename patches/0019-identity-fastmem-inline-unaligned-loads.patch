+    check("16-bit load", st_load16(view, &base));
+    check("32-bit load", st_load32(view, &base));
+    check("signed 8-bit load", st_load8s(view, &base));
+    check("signed 16-bit load", st_load16s(view, &base));
+    check("pair of loads", st_pair(view, &base));
+    check("load at a 12-bit offset", st_far(view, &base));
+    check("load into a float", st_float(view, &base));
+    check("loads in a loop", st_loop(view, &base));
+    check("register-indexed loads", st_indexed(view, &base, &index));
+    check("128-bit load", st_vector(view, &base));
+    check("stores", st_stores(view, &base, &index, 0x12345678u));
+    return ok;
