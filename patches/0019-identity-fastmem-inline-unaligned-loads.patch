+void GuestMemory::identity_fault(int signal, void *info, void *context) {
+    const auto address = reinterpret_cast<std::uintptr_t>(static_cast<siginfo_t *>(info)->si_addr);
+    static std::atomic<int> logged{0};
+    const auto say = [&](const char *what) {
+        if (logged.fetch_add(1) >= 16) return;
+        char line[112];
+        const int length = std::snprintf(line, sizeof line, "[fastmem] guest access at 0x%08lx: %s\n",
+                                         static_cast<unsigned long>(address), what);
+        if (length > 0) (void)!write(2, line, static_cast<std::size_t>(length));
+    };
+    if (address < 0x1000u) {
