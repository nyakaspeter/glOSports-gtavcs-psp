+namespace {
+// The first page cannot be mapped (vm.mmap_min_addr), and a guest load
+// through a null pointer plus a small offset lands there. In the window such
+// a load read zero and a store went nowhere that mattered; here the handler
+// does the same for the faulting instruction itself: it finds the load's
+// destination (a core register, a VFP register or NEON registers) and zeroes
+// it, drops a store, applies the instruction's base register writeback, and
+// steps over it (advancing the IT state). Only for Thumb-2 code inside this
+// executable (the generated units), and only the load and store forms GCC
+// emits for the accessors; anything else stays a crash, with a line saying so.
+bool emulate_null_page_access(void *context_pointer) noexcept {
+    auto *const context = static_cast<ucontext_t *>(context_pointer);
+    auto &machine = context->uc_mcontext;
+    const std::uintptr_t pc = machine.arm_pc & ~std::uintptr_t{1};
+    if ((machine.arm_cpsr & (1u << 5u)) == 0u) return false;  // ARM state: not the generated code
+    if (pc < reinterpret_cast<std::uintptr_t>(__executable_start) || pc >= reinterpret_cast<std::uintptr_t>(etext))
+        return false;
+    unsigned long *const reg = &machine.arm_r0;  // r0..r15 in order
+    std::uint16_t hw1, hw2 = 0u;
+    std::memcpy(&hw1, reinterpret_cast<const void *>(pc), 2u);
+    unsigned length = 2u;
+    // The VFP registers of the interrupted code, in the signal frame.
+    const auto vfp = [&]() -> unsigned long long * {
+        unsigned long *frame = context->uc_regspace;
+        for (int guard = 0; guard < 8 && frame[0] != 0u; ++guard) {
+            if (frame[0] == 0x56465001u) return reinterpret_cast<unsigned long long *>(frame + 2);
+            if (frame[1] < 8u || frame[1] > sizeof(context->uc_regspace)) break;
+            frame = reinterpret_cast<unsigned long *>(reinterpret_cast<char *>(frame) + frame[1]);
+        }
+        return nullptr;
+    };
+    if ((hw1 & 0xF800u) == 0x6800u || (hw1 & 0xF800u) == 0x7800u || (hw1 & 0xF800u) == 0x8800u) {
+        reg[hw1 & 7u] = 0u;                                     // LDR / LDRB / LDRH Rt, [Rn, #imm5]
+    } else if ((hw1 & 0xF800u) == 0x6000u || (hw1 & 0xF800u) == 0x7000u || (hw1 & 0xF800u) == 0x8000u) {
+        // STR / STRB / STRH Rt, [Rn, #imm5]: dropped
+    } else if ((hw1 & 0xF000u) == 0x5000u) {
+        if (((hw1 >> 9u) & 7u) >= 3u) reg[hw1 & 7u] = 0u;       // register offset: 3..7 are the loads
+    } else if ((hw1 & 0xF800u) >= 0xE800u) {
+        std::memcpy(&hw2, reinterpret_cast<const void *>(pc + 2u), 2u);
+        length = 4u;
+        const unsigned rn = hw1 & 15u;
+        if ((hw1 & 0xFE00u) == 0xF800u && !((hw1 & 0x0100u) != 0u && (hw1 & 0x0010u) == 0u)) {
+            // LDR/LDRB/LDRH/LDRSB/LDRSH/STR/STRB/STRH, 12-bit, 8-bit or register offset
+            // (0xF9.. with the load bit clear is not a store: that is NEON, below)
+            const unsigned rt = hw2 >> 12u;
+            const bool load = (hw1 & 0x0010u) != 0u;
+            if (rn == 15u || (load && rt == 15u)) return false;  // literal, preload or a branch
+            if (load) reg[rt] = 0u;
+            if ((hw1 & 0x0080u) == 0u && (hw2 & 0x0800u) != 0u && (hw2 & 0x0100u) != 0u) {
+                const unsigned long offset = hw2 & 0xFFu;       // writeback
+                reg[rn] = (hw2 & 0x0200u) != 0u ? reg[rn] + offset : reg[rn] - offset;
+            }
+        } else if ((hw1 & 0xFE40u) == 0xE840u && (hw1 & 0x0120u) != 0u) {
+            // LDRD / STRD Rt, Rt2, [Rn, #imm8 * 4]
+            if (rn == 15u) return false;
+            if ((hw1 & 0x0010u) != 0u) { reg[hw2 >> 12u] = 0u; reg[(hw2 >> 8u) & 15u] = 0u; }
+            if ((hw1 & 0x0020u) != 0u) {
+                const unsigned long offset = (hw2 & 0xFFu) * 4u;
+                reg[rn] = (hw1 & 0x0080u) != 0u ? reg[rn] + offset : reg[rn] - offset;
+            }
+        } else if ((hw1 & 0xFF20u) == 0xED00u && (hw2 & 0x0E00u) == 0x0A00u) {
+            // VLDR / VSTR Sd or Dd, [Rn, #imm8 * 4]
+            if ((hw1 & 0x0010u) != 0u) {
+                unsigned long long *const registers = vfp();
+                if (registers == nullptr) return false;
+                const unsigned vd = hw2 >> 12u;
+                const unsigned d = (hw1 >> 6u) & 1u;
+                if ((hw2 & 0x0100u) != 0u) {
+                    registers[(d << 4u) | vd] = 0u;             // Dd
+                } else {
+                    const unsigned single = (vd << 1u) | d;     // Sd: half of D(single / 2)
+                    const unsigned shift = (single & 1u) * 32u;
+                    registers[single >> 1u] &= ~(0xFFFFFFFFull << shift);
+                }
+            }
+        } else if ((hw1 & 0xFF90u) == 0xF900u) {
+            // VLD1 / VST1 (whole registers) [Rn], optional writeback
+            const unsigned type = (hw2 >> 8u) & 15u;
+            const unsigned count = type == 7u ? 1u : type == 10u ? 2u : type == 6u ? 3u : type == 2u ? 4u : 0u;
+            if (count == 0u) return false;
+            if ((hw1 & 0x0020u) != 0u) {
+                unsigned long long *const registers = vfp();
+                if (registers == nullptr) return false;
+                const unsigned first = (((hw1 >> 6u) & 1u) << 4u) | (hw2 >> 12u);
+                for (unsigned index = 0u; index < count && first + index < 32u; ++index) registers[first + index] = 0u;
+            }
+            const unsigned rm = hw2 & 15u;
+            if (rm == 13u) reg[rn] += 8u * count;
+            else if (rm != 15u) reg[rn] += reg[rm];
+        } else {
+            return false;
+        }
+    } else {
+        return false;
+    }
+    // Step over it; inside an IT block the state moves on as if it had run.
+    unsigned long cpsr = machine.arm_cpsr;
+    unsigned it = static_cast<unsigned>(((cpsr >> 8u) & 0xFCu) | ((cpsr >> 25u) & 3u));
+    if ((it & 7u) == 0u) it = 0u;
+    else it = (it & 0xE0u) | ((it << 1u) & 0x1Fu);
