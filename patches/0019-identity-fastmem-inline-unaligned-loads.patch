+// Maps what the guest touched outside the mirrors mapped at start: RAM or
+// VRAM through another mirror gets the same memory, any other address a
+// private zero page block (64 KB). False when the address cannot be mapped
+// (the first page, the kernel's part of the address space, or host memory).
+bool GuestMemory::identity_map_on_demand(std::uintptr_t address) noexcept {
+    if (address < 0x1000u || address >= 0xC0000000u) return false;
+    const std::uint32_t mirror = static_cast<std::uint32_t>(address) & 0xE0000000u;
+    const std::uint32_t physical = static_cast<std::uint32_t>(address) & kWindowMask;
+    const auto map_at = [](std::uint32_t at_address, std::size_t bytes, int fd) {
+        void *const at = reinterpret_cast<void *>(static_cast<std::uintptr_t>(at_address));
+        void *const got = fd >= 0
+            ? mmap(at, bytes, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_FIXED_NOREPLACE, fd, 0)
+            : mmap(at, bytes, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+        if (got == at) return true;
+        if (got != MAP_FAILED) munmap(got, bytes);
+        return false;
+    };
+    if (physical >= kPhysicalBase && physical - kPhysicalBase < bytes_.size()) {
+        if (!map_at(mirror + kPhysicalBase, bytes_.size(), ram_fd_)) return false;
+        identity_all_mirrors_ = true;
+        return true;
+    }
+    if (physical >= kVramPhysicalBase && physical - kVramPhysicalBase < kVramAddressSpan) {
+        const std::uint32_t copy = (physical - kVramPhysicalBase) / kVramSize;
+        if (!map_at(mirror + kVramPhysicalBase + copy * kVramSize, kVramSize, vram_fd_)) return false;
+        identity_all_mirrors_ = true;
+        return true;
+    }
+    return map_at(static_cast<std::uint32_t>(address) & ~0xFFFFu, 0x10000u, -1);
+}
