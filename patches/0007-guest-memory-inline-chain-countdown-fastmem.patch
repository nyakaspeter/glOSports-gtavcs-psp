+    // vtfm / vhtfm by a Side x Side matrix. Row r of the result is
+    // ((m[r][0] t[0] + m[r][1] t[1]) + m[r][2] t[2]) + m[r][3] t[3], summed in that
+    // order in both forms.
+    template <std::uint32_t DestinationRegister, std::uint32_t MatrixRegister, std::uint32_t TargetRegister,
+              std::uint32_t Side, std::uint32_t InputLength>
+    PSPRECOMP_CONTEXT_FORCEINLINE void vfpu_vtfm_q() noexcept {
+        static_assert(Side == 3u || Side == 4u);
+        static_assert(InputLength >= 1u && InputLength <= Side);
