+    // mul.s. The PSP yields the positive quiet NaN 0x7FC00000 for inf*0. ARM's
+    // VFP produces exactly that default NaN by itself; x86 produces the
+    // negative one, so only non-ARM hosts need the check.
+    [[nodiscard]] PSPRECOMP_CONTEXT_FORCEINLINE static float fpu_mul(float a, float b) noexcept {
+#if defined(__arm__) || defined(__aarch64__)
+        return a * b;
+#else
+        if ((std::isinf(a) && b == 0.0f) || (std::isinf(b) && a == 0.0f)) return std::bit_cast<float>(0x7FC00000u);
+        return a * b;
+#endif
+    }
