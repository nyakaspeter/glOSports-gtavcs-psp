+    // vadd / vsub / vmul (Operation 0 / 1 / 2) over 3 or 4 lanes.
+    template <std::uint32_t Operation, std::uint32_t DestinationRegister, std::uint32_t SourceRegister,
+              std::uint32_t TargetRegister, std::uint32_t Length>
+    PSPRECOMP_CONTEXT_FORCEINLINE void vfpu_vec_q() noexcept {
+        static_assert(Operation <= 2u);
+#if defined(__ARM_NEON)
+        const float32x4_t s = vfpu_load_q<SourceRegister, Length>();
+        const float32x4_t t = vfpu_load_q<TargetRegister, Length>();
+        if constexpr (Operation == 0u) vfpu_store_q<DestinationRegister, Length>(vaddq_f32(s, t));
+        else if constexpr (Operation == 1u) vfpu_store_q<DestinationRegister, Length>(vsubq_f32(s, t));
+        else vfpu_store_q<DestinationRegister, Length>(vmulq_f32(s, t));
+#else
+        float s[4]{}, t[4]{}, d[4]{};
+        read_vfpu_vector_ct<SourceRegister, Length>(s);
+        read_vfpu_vector_ct<TargetRegister, Length>(t);
