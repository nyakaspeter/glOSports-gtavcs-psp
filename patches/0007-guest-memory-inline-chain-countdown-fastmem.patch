+    [[gnu::noinline, gnu::cold]] void vfpu_lvq_misaligned(Memory memory, std::uint32_t address) noexcept {
+        vfpu_lvq_words<VectorRegister>(memory, address);
+    }
+    template <std::uint32_t VectorRegister, class Memory>
+    [[gnu::noinline, gnu::cold]] void vfpu_svq_misaligned(Memory memory, std::uint32_t address) const noexcept {
+        vfpu_svq_words<VectorRegister>(memory, address);
+    }
+#endif
