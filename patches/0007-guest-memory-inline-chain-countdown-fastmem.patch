+        // The input: lanes from InputLength on are zero, lane Side-1 is one when it
+        // lies beyond the input (the homogeneous forms).
+        float32x4_t t = vfpu_load_q<TargetRegister, Side>();
+        if constexpr (InputLength <= 1u) t = vsetq_lane_f32(0.0f, t, 1);
+        if constexpr (InputLength <= 2u && Side == 4u) t = vsetq_lane_f32(0.0f, t, 2);
+        if constexpr (InputLength < Side) t = vsetq_lane_f32(1.0f, t, Side - 1u);
+        float32x4_t result = vmulq_lane_f32(vfpu_matrix_column_q<MatrixRegister, Side, 0u>(), vget_low_f32(t), 0);
+        result = vaddq_f32(result, vmulq_lane_f32(vfpu_matrix_column_q<MatrixRegister, Side, 1u>(), vget_low_f32(t), 1));
+        result = vaddq_f32(result, vmulq_lane_f32(vfpu_matrix_column_q<MatrixRegister, Side, 2u>(), vget_high_f32(t), 0));
+        if constexpr (Side == 4u)
+            result = vaddq_f32(result, vmulq_lane_f32(vfpu_matrix_column_q<MatrixRegister, Side, 3u>(), vget_high_f32(t), 1));
+        // The scalar form starts each row at 0.0f (and adds a 0 * 0 fourth
+        // product to the last row of a 3x3). A zero added anywhere in a sum only
+        // ever turns an exactly zero running sum positive, so one final + 0.0f on
+        // every lane gives the same bits.
+        result = vaddq_f32(result, vdupq_n_f32(0.0f));
+        vfpu_store_q<DestinationRegister, Side>(result);
+#else
