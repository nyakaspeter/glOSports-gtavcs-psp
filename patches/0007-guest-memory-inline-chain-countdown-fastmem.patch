+#if defined(__ARM_NEON)
+    // Lanes 0..Length-1 of a 3- or 4-lane register in a q register. Lane 3 of a
+    // 3-lane read is whatever follows in vfpu[]; nothing stores it back.
+    template <std::uint32_t VectorRegister, std::uint32_t Length>
+    [[nodiscard]] PSPRECOMP_CONTEXT_FORCEINLINE float32x4_t vfpu_load_q() const noexcept {
+        static_assert(Length == 3u || Length == 4u);
+        constexpr std::size_t s0 = vfpu_vector_lane_index(VectorRegister, Length, 0u);
+        const float *const p = vfpu.data();
+        if constexpr (vfpu_lanes_contiguous<VectorRegister, Length>() && (s0 & 3u) == 0u) {
+            return vld1q_f32(p + s0);
+        } else if constexpr (vfpu_lanes_contiguous<VectorRegister, Length>()) {
+            static_assert(Length == 3u && (s0 & 3u) == 1u);  // a column vector starting at row 1
+            const float32x4_t column = vld1q_f32(p + (s0 & ~std::size_t{3u}));
+            return vextq_f32(column, column, 1);
+        } else {
+            float32x4_t v = vld1q_dup_f32(p + s0);
+            v = vld1q_lane_f32(p + vfpu_vector_lane_index(VectorRegister, Length, 1u), v, 1);
+            v = vld1q_lane_f32(p + vfpu_vector_lane_index(VectorRegister, Length, 2u), v, 2);
+            if constexpr (Length == 4u) v = vld1q_lane_f32(p + vfpu_vector_lane_index(VectorRegister, Length, 3u), v, 3);
+            return v;
+        }
+    }
+
+    template <std::uint32_t VectorRegister, std::uint32_t Length>
+    PSPRECOMP_CONTEXT_FORCEINLINE void vfpu_store_q(float32x4_t value) noexcept {
+        static_assert(Length == 3u || Length == 4u);
+        constexpr std::size_t s0 = vfpu_vector_lane_index(VectorRegister, Length, 0u);
+        constexpr std::size_t s1 = vfpu_vector_lane_index(VectorRegister, Length, 1u);
+        constexpr std::size_t s2 = vfpu_vector_lane_index(VectorRegister, Length, 2u);
+        float *const p = vfpu.data();
+        if constexpr (Length == 4u && vfpu_lanes_contiguous<VectorRegister, 4u>()) {
+            vst1q_f32(p + s0, value);
+        } else if constexpr (Length == 3u && s1 == s0 + 1u) {
+            vst1_f32(p + s0, vget_low_f32(value));
+            vst1q_lane_f32(p + s2, value, 2);
+        } else {
+            vst1q_lane_f32(p + s0, value, 0);
+            vst1q_lane_f32(p + s1, value, 1);
+            vst1q_lane_f32(p + s2, value, 2);
+            if constexpr (Length == 4u) vst1q_lane_f32(p + vfpu_vector_lane_index(VectorRegister, Length, 3u), value, 3);
+        }
+    }
+
+    // Lanes 0..Side-1 hold vfpu_matrix[r * 4 + ColumnIndex], r = 0..Side-1: the
+    // column of the matrix that vtfm multiplies by target[ColumnIndex]. Stride 1
+    // in vfpu[] for the E (transposed) registers the game transforms with.
+    template <std::uint32_t MatrixRegister, std::uint32_t Side, std::uint32_t ColumnIndex>
+    [[nodiscard]] PSPRECOMP_CONTEXT_FORCEINLINE float32x4_t vfpu_matrix_column_q() const noexcept {
+        static_assert(Side == 3u || Side == 4u);
+        constexpr std::size_t s0 = vfpu_matrix_slot<MatrixRegister, Side>(0u, ColumnIndex);
+        constexpr std::size_t s1 = vfpu_matrix_slot<MatrixRegister, Side>(1u, ColumnIndex);
+        constexpr std::size_t s2 = vfpu_matrix_slot<MatrixRegister, Side>(2u, ColumnIndex);
+        constexpr std::size_t s3 = Side == 4u ? vfpu_matrix_slot<MatrixRegister, Side>(3u, ColumnIndex) : s0 + 3u;
+        constexpr bool contiguous = s1 == s0 + 1u && s2 == s0 + 2u && s3 == s0 + 3u;
+        const float *const p = vfpu.data();
+        if constexpr (contiguous && (s0 & 3u) == 0u) {
+            return vld1q_f32(p + s0);
+        } else if constexpr (contiguous) {
+            static_assert(Side == 3u && (s0 & 3u) == 1u);
+            const float32x4_t group = vld1q_f32(p + (s0 & ~std::size_t{3u}));
+            return vextq_f32(group, group, 1);
+        } else {
+            float32x4_t v = vld1q_dup_f32(p + s0);
+            v = vld1q_lane_f32(p + s1, v, 1);
+            v = vld1q_lane_f32(p + s2, v, 2);
+            if constexpr (Side == 4u) v = vld1q_lane_f32(p + s3, v, 3);
+            return v;
+        }
