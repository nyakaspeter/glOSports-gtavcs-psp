+    // ---- NEON forms of the frequent vector operations (generator --neon) ----
+    // Each *_q helper has its NEON body under __ARM_NEON and the scalar form, in
+    // the same operation order, under #else, so a unit emitted with --neon is one
+    // line per operation and still builds on any host. The generator emits them
+    // only where all three prefixes are known to be the defaults (PrefixState),
+    // so there is no prefix handling here. A vector register's lanes sit at
+    // vfpu_vector_lane_index(R, L, i): stride 1 for the column (C) vectors the
+    // game uses almost everywhere, stride 4 for the row (R) vectors.
+    template <std::uint32_t VectorRegister, std::uint32_t Length>
+    [[nodiscard]] static constexpr bool vfpu_lanes_contiguous() noexcept {
+        for (std::uint32_t i = 1u; i < Length; ++i)
+            if (vfpu_vector_lane_index(VectorRegister, Length, i) !=
+                vfpu_vector_lane_index(VectorRegister, Length, 0u) + i) return false;
+        return true;
+    }
+
+    // Slot of the vfpu_matrix[row_index * 4 + column_index] that read_vfpu_matrix fills.
+    template <std::uint32_t MatrixRegister, std::uint32_t Side>
+    [[nodiscard]] static constexpr std::size_t vfpu_matrix_slot(std::uint32_t row_index,
+                                                                std::uint32_t column_index) noexcept {
+        const std::uint32_t matrix = (MatrixRegister >> 2u) & 7u;
+        const std::uint32_t column = MatrixRegister & 3u;
+        bool transpose = ((MatrixRegister >> 5u) & 1u) != 0u;
+        std::uint32_t row = 0u;
+        if (Side == 1u) { transpose = false; row = (MatrixRegister >> 5u) & 3u; }
+        else if (Side == 2u || Side == 4u) row = (MatrixRegister >> 5u) & 2u;
+        else if (Side == 3u) row = (MatrixRegister >> 6u) & 1u;
+        const std::size_t base = static_cast<std::size_t>(matrix * 16u);
+        return transpose
+            ? base + static_cast<std::size_t>(((row + column_index) & 3u) * 4u + ((column + row_index) & 3u))
+            : base + static_cast<std::size_t>(((column + row_index) & 3u) * 4u + ((row + column_index) & 3u));
+    }
