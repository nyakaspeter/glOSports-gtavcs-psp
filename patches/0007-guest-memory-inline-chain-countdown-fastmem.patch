+
+    template <std::uint32_t VectorRegister, class Memory>
+    PSPRECOMP_CONTEXT_FORCEINLINE void vfpu_lvq_words(const Memory &memory, std::uint32_t address) noexcept {
+        const float value[4]{
+            std::bit_cast<float>(memory.aot_load32(address + 0u)),
+            std::bit_cast<float>(memory.aot_load32(address + 4u)),
+            std::bit_cast<float>(memory.aot_load32(address + 8u)),
+            std::bit_cast<float>(memory.aot_load32(address + 12u))};
+        write_vfpu_vector_ct<VectorRegister, 4u>(value);
+    }
+
+    template <std::uint32_t VectorRegister, class Memory>
+    PSPRECOMP_CONTEXT_FORCEINLINE void vfpu_svq_words(const Memory &memory, std::uint32_t address) const noexcept {
+        float value[4]{};
+        read_vfpu_vector_ct<VectorRegister, 4u>(value);
+        memory.aot_store32(address + 0u, std::bit_cast<std::uint32_t>(value[0]));
+        memory.aot_store32(address + 4u, std::bit_cast<std::uint32_t>(value[1]));
+        memory.aot_store32(address + 8u, std::bit_cast<std::uint32_t>(value[2]));
+        memory.aot_store32(address + 12u, std::bit_cast<std::uint32_t>(value[3]));
+    }
